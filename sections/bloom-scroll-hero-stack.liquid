{{ 'bloom-scroll-hero-stack.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bloom-scroll-hero-stack.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign section_st = section.settings
  assign block_count = section.blocks.size
  assign scroll_mult = section_st.scroll_distance_multiplier | default: 100 | divided_by: 100.0
  assign track_height_val = block_count | times: 90 | times: scroll_mult | round
  if track_height_val < 150
    assign track_height_val = 150
  endif
-%}

{%- if section_st.enable_section and block_count > 0 -%}
  <bloom-scroll-hero-stack
    id="bloom-shs-{{ section.id }}"
    class="bloom-shs-section"
    data-section-id="{{ section.id }}"
    data-animation="{{ section_st.enable_scroll_animation }}"
    data-parallax="{{ section_st.enable_image_parallax }}"
    style="
      --bshs-bg: {{ section_st.section_bg_color | default: '#FAF9F0' }};
      --bshs-max-w: {{ section_st.container_max_width | default: 1440 }}px;
      --bshs-track-height: {{ track_height_val }}vh;
      --bshs-item-h-desktop: {{ section_st.desktop_height | default: 75 }}vh;
      --bshs-item-h-mobile: {{ section_st.mobile_height | default: 65 }}vh;
      --bshs-radius: {{ section_st.card_radius | default: 28 }}px;
      --bshs-gap: {{ section_st.card_gap | default: 30 }}px;
      --bshs-overlay-opacity: {{ section_st.overlay_opacity | default: 25 | divided_by: 100.0 }};
      --bshs-heading-sz: {{ section_st.heading_size_desktop | default: 56 }}px;
      --bshs-heading-sz-mb: {{ section_st.heading_size_mobile | default: 32 }}px;
      --bshs-pt-desktop: {{ section_st.padding_top_desktop | default: 60 }}px;
      --bshs-pb-desktop: {{ section_st.padding_bottom_desktop | default: 60 }}px;
      --bshs-pt-mobile: {{ section_st.padding_top_mobile | default: 30 }}px;
      --bshs-pb-mobile: {{ section_st.padding_bottom_mobile | default: 30 }}px;
    "
  >
    <div class="bloom-shs__container">
      <!-- Outer Track dictates the vertical scroll distance -->
      <div class="bloom-shs__track">
        <!-- Sticky Window pins inside track during scrolling -->
        <div class="bloom-shs__sticky-viewport">
          <div class="bloom-shs__slides-row">

            {%- for block in section.blocks -%}
              {%- liquid
                assign block_st = block.settings
                assign btn_url = block_st.button_link
                if btn_url == blank
                  assign btn_url = routes.all_products_collection_url
                endif

                assign focal = block_st.image_focal_point | default: 'center center'
                assign content_pos = block_st.content_position | default: 'center-start'
              -%}

              <div
                class="bloom-shs__slide"
                data-index="{{ forloop.index0 }}"
                data-block-id="{{ block.id }}"
                {{ block.shopify_attributes }}
              >
                <!-- Media Layer -->
                <div class="bloom-shs__media">
                  <picture>
                    {%- if block_st.mobile_image != blank -%}
                      <source
                        media="(max-width: 767px)"
                        srcset="{{ block_st.mobile_image | image_url: width: 1200 }}"
                      >
                    {%- endif -%}

                    {%- if block_st.image != blank -%}
                      <img
                        src="{{ block_st.image | image_url: width: 2600 }}"
                        alt="{{ block_st.heading | escape }} {{ block_st.italic_heading | escape }}"
                        class="bloom-shs__img"
                        width="2600"
                        height="1460"
                        loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                        style="--bshs-focal: {{ focal }};"
                      >
                    {%- else -%}
                      {%- liquid
                        assign fallback_asset = 'bloom-scroll-banner-1.jpg'
                        if forloop.index == 2
                          assign fallback_asset = 'bloom-scroll-banner-2.jpg'
                        elsif forloop.index == 3
                          assign fallback_asset = 'bloom-scroll-banner-3.jpg'
                        endif
                      -%}
                      <img
                        src="{{ fallback_asset | asset_url }}"
                        alt="{{ block_st.heading | escape }} {{ block_st.italic_heading | escape }}"
                        class="bloom-shs__img"
                        width="2600"
                        height="1460"
                        loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                        style="--bshs-focal: {{ focal }};"
                      >
                    {%- endif -%}
                  </picture>

                  <!-- Image Overlay -->
                  <div
                    class="bloom-shs__overlay"
                    {% if block_st.overlay_opacity_override > 0 %}
                      style="opacity: {{ block_st.overlay_opacity_override | divided_by: 100.0 }};"
                    {% endif %}
                  ></div>
                </div>

                <!-- Text & Button Content Layer -->
                <div class="bloom-shs__content bloom-shs__content--{{ content_pos }}">
                  <div class="bloom-shs__text-wrapper">
                    {%- if block_st.heading != blank or block_st.italic_heading != blank -%}
                      <h2 class="bloom-shs__heading">
                        {%- if block_st.heading != blank -%}
                          <span class="bloom-shs__heading-regular">{{ block_st.heading }}</span>
                        {%- endif -%}
                        {%- if block_st.italic_heading != blank -%}
                          <em class="bloom-shs__heading-italic">{{ block_st.italic_heading }}</em>
                        {%- endif -%}
                      </h2>
                    {%- endif -%}

                    {%- if block_st.subtitle != blank -%}
                      <p class="bloom-shs__subtitle">{{ block_st.subtitle }}</p>
                    {%- endif -%}

                    {%- if block_st.button_label != blank -%}
                      <div class="bloom-shs__btn-wrap">
                        <a
                          href="{{ btn_url }}"
                          class="bloom-shs__btn"
                          aria-label="{{ block_st.button_label }}: {{ block_st.heading }} {{ block_st.italic_heading }}"
                        >
                          {{ block_st.button_label }}
                        </a>
                      </div>
                    {%- endif -%}
                  </div>
                </div>

              </div>
            {%- endfor -%}

          </div>
        </div>
      </div>
    </div>
  </bloom-scroll-hero-stack>
{%- endif -%}

{% schema %}
{
  "name": "Bloom Scroll Hero Stack",
  "tag": "section",
  "class": "section-bloom-scroll-hero-stack",
  "settings": [
    {
      "type": "header",
      "content": "Section Visibility & Scroll Animation"
    },
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable Section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_scroll_animation",
      "label": "Enable Scroll-Driven Sequence",
      "info": "Drives the banner transitions smoothly as the visitor scrolls down the page",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_image_parallax",
      "label": "Enable Subtle Image Parallax",
      "info": "Adds cinematic horizontal depth to the plant imagery during scroll",
      "default": true
    },
    {
      "type": "range",
      "id": "scroll_distance_multiplier",
      "min": 60,
      "max": 160,
      "step": 10,
      "unit": "%",
      "label": "Scroll Animation Duration",
      "info": "Higher values provide a more relaxed, extended scrolling experience",
      "default": 100
    },
    {
      "type": "header",
      "content": "Dimensions & Container"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section Background Color",
      "default": "#FAF9F0"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 1000,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Container Maximum Width",
      "default": 1440
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Desktop Banner Height",
      "default": 75
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 45,
      "max": 95,
      "step": 5,
      "unit": "vh",
      "label": "Mobile Banner Height",
      "default": 65
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Banner Corner Radius",
      "default": 28
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Gap Between Banners",
      "default": 30
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Default Image Overlay Opacity",
      "default": 25
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 32,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Desktop Heading Size",
      "default": 56
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 24,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Mobile Heading Size",
      "default": 32
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Image (Optional)"
        },
        {
          "type": "select",
          "id": "image_focal_point",
          "label": "Image Focal Point",
          "options": [
            { "value": "center center", "label": "Center" },
            { "value": "center left", "label": "Center Left" },
            { "value": "center right", "label": "Center Right" },
            { "value": "top center", "label": "Top Center" },
            { "value": "bottom center", "label": "Bottom Center" }
          ],
          "default": "center center"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading Regular Text",
          "default": "Bring Nature"
        },
        {
          "type": "text",
          "id": "italic_heading",
          "label": "Heading Italic Phrase",
          "default": "Inside"
        },
        {
          "type": "textarea",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Beautiful, easy-care plants delivered to your door."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content Position",
          "options": [
            { "value": "center-start", "label": "Middle Left" },
            { "value": "top-start", "label": "Top Left" },
            { "value": "bottom-start", "label": "Bottom Left" },
            { "value": "center-center", "label": "Center" }
          ],
          "default": "center-start"
        },
        {
          "type": "range",
          "id": "overlay_opacity_override",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "label": "Overlay Opacity Override (0 = Use Section Default)",
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bloom Scroll Hero Stack",
      "settings": {
        "enable_section": true,
        "enable_scroll_animation": true,
        "enable_image_parallax": true,
        "scroll_distance_multiplier": 100,
        "section_bg_color": "#FAF9F0",
        "container_max_width": 1440,
        "desktop_height": 75,
        "mobile_height": 65,
        "card_radius": 28,
        "card_gap": 30,
        "heading_size_desktop": 56,
        "heading_size_mobile": 32,
        "padding_top_desktop": 60,
        "padding_bottom_desktop": 60,
        "padding_top_mobile": 30,
        "padding_bottom_mobile": 30
      },
      "blocks": [
        {
          "type": "banner",
          "settings": {
            "heading": "Bring Nature",
            "italic_heading": "Inside",
            "subtitle": "Beautiful, easy-care plants delivered to your door.",
            "button_label": "SHOP NOW",
            "button_link": "/collections/all",
            "content_position": "center-start"
          }
        },
        {
          "type": "banner",
          "settings": {
            "heading": "Grow Beauty",
            "italic_heading": "At Home",
            "subtitle": "Low-maintenance plants designed for modern living.",
            "button_label": "SHOP NOW",
            "button_link": "/collections/all",
            "content_position": "center-start"
          }
        },
        {
          "type": "banner",
          "settings": {
            "heading": "Create Your",
            "italic_heading": "Green Corner",
            "subtitle": "Fresh, hand-picked plants to brighten every space in your home.",
            "button_label": "SHOP NOW",
            "button_link": "/collections/all",
            "content_position": "center-start"
          }
        }
      ]
    }
  ]
}
{% endschema %}
