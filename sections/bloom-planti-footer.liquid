{{ 'bloom-planti-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign bg_color           = section.settings.bg_color
  assign text_color         = section.settings.text_color
  assign text_secondary     = section.settings.text_secondary
  assign divider_color      = section.settings.divider_color
  assign wordmark_color     = section.settings.wordmark_color
  assign wordmark_text      = section.settings.wordmark_text
  assign wordmark_size      = section.settings.wordmark_size
  assign content_max_width  = section.settings.content_max_width
  assign col_gap            = section.settings.col_gap
  assign pt_desktop         = section.settings.padding_top
  assign pb_desktop         = section.settings.padding_bottom
  assign pt_mobile          = section.settings.mobile_padding_top
  assign pb_mobile          = section.settings.mobile_padding_bottom

  assign brand_heading      = section.settings.brand_heading
  assign brand_desc         = section.settings.brand_description

  assign show_fb            = section.settings.show_facebook
  assign show_ig            = section.settings.show_instagram
  assign show_yt            = section.settings.show_youtube
  assign show_tt            = section.settings.show_tiktok
  assign show_x             = section.settings.show_x

  assign fb_url             = section.settings.facebook_url
  assign ig_url             = section.settings.instagram_url
  assign yt_url             = section.settings.youtube_url
  assign tt_url             = section.settings.tiktok_url
  assign x_url              = section.settings.x_url

  assign show_country       = section.settings.show_country_selector
  assign show_language      = section.settings.show_language_selector

  assign quicklinks_menu    = section.settings.quicklinks_menu
  assign about_menu         = section.settings.about_menu

  assign nl_heading         = section.settings.newsletter_heading
  assign nl_desc            = section.settings.newsletter_description
  assign nl_placeholder     = section.settings.newsletter_placeholder
  assign nl_btn_label       = section.settings.newsletter_button_label

  assign show_copyright     = section.settings.show_copyright
  assign brand_name         = section.settings.brand_name
  assign show_payments      = section.settings.show_payment_icons
  assign show_wordmark      = section.settings.show_wordmark

  assign serif_font         = section.settings.serif_heading_size
  assign nl_heading_size    = section.settings.newsletter_heading_size

  assign form_id = 'bloom-footer-newsletter-' | append: section.id
-%}

{%- comment -%}
  Inline CSS variables so every setting from Theme Editor is reflected live
{%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .bloom-footer {
    --bf-bg:                    {{ bg_color }};
    --bf-text:                  {{ text_color }};
    --bf-text-secondary:        {{ text_secondary }};
    --bf-divider:               {{ divider_color }};
    --bf-wordmark-color:        {{ wordmark_color }};
    --bf-max-width:             {{ content_max_width }}px;
    --bf-col-gap:               {{ col_gap }}px;
    --bf-pt:                    {{ pt_desktop }}px;
    --bf-pb:                    {% if show_wordmark and wordmark_text != blank %}8px{% else %}{{ pb_desktop }}px{% endif %};
    --bf-mobile-pt:             {{ pt_mobile }}px;
    --bf-mobile-pb:             {% if show_wordmark and wordmark_text != blank %}6px{% else %}{{ pb_mobile }}px{% endif %};
    --bf-brand-heading-size:    {{ serif_font }}px;
    --bf-newsletter-heading-size: {{ nl_heading_size }}px;
    --bf-wordmark-size:         clamp(5.5rem, 28.5vw, {{ wordmark_size | at_least: 520 }}px);
  }
{%- endstyle -%}

<footer class="bloom-footer" id="bloom-footer-{{ section.id }}" role="contentinfo">
  <div class="bloom-footer__inner">

    {%- comment -%}============================================================
      MAIN 4-COLUMN GRID
    ============================================================{%- endcomment -%}
    <div class="bloom-footer__columns">

      {%- comment -%}------- Column 1: Brand + Social + Selectors -------{%- endcomment -%}
      <div class="bloom-footer__col bloom-footer__col--brand">

        {%- if brand_heading != blank -%}
          <a href="{{ routes.root_url }}" class="bloom-footer__brand-heading" aria-label="{{ brand_heading }} — Home">
            {{- brand_heading -}}
          </a>
        {%- endif -%}

        {%- if brand_desc != blank -%}
          <p class="bloom-footer__brand-desc">{{ brand_desc }}</p>
        {%- endif -%}

        {%- comment -%}Social Icons{%- endcomment -%}
        {%- assign has_social = false -%}
        {%- if show_fb and fb_url != blank -%}{%- assign has_social = true -%}{%- endif -%}
        {%- if show_ig and ig_url != blank -%}{%- assign has_social = true -%}{%- endif -%}
        {%- if show_yt and yt_url != blank -%}{%- assign has_social = true -%}{%- endif -%}
        {%- if show_tt and tt_url != blank -%}{%- assign has_social = true -%}{%- endif -%}
        {%- if show_x and x_url != blank -%}{%- assign has_social = true -%}{%- endif -%}

        {%- if has_social -%}
          <ul class="bloom-footer__social" role="list" aria-label="{{ 'general.social.follow_on' | t | default: 'Follow us on social media' }}">

            {%- if show_fb and fb_url != blank -%}
              <li>
                <a href="{{ fb_url }}" class="bloom-footer__social-link" target="_blank" rel="noopener noreferrer nofollow" aria-label="{{ 'general.social.links.facebook' | t | default: 'Follow on Facebook' }}">
                  <svg viewBox="0 0 320 512" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                    <path d="M80 299.3V512H196V299.3h86.5l18-97.8H196V166.9c0-51.7 20.3-71.5 72.7-71.5c16.3 0 29.4.4 37 1.2V7.9C291.4 4 256.4 0 236.2 0C129.3 0 80 50.5 80 159.4v42.1H14v97.8H80z"/>
                  </svg>
                </a>
              </li>
            {%- endif -%}

            {%- if show_ig and ig_url != blank -%}
              <li>
                <a href="{{ ig_url }}" class="bloom-footer__social-link" target="_blank" rel="noopener noreferrer nofollow" aria-label="{{ 'general.social.links.instagram' | t | default: 'Follow on Instagram' }}">
                  <svg viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                    <path d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z"/>
                  </svg>
                </a>
              </li>
            {%- endif -%}

            {%- if show_yt and yt_url != blank -%}
              <li>
                <a href="{{ yt_url }}" class="bloom-footer__social-link" target="_blank" rel="noopener noreferrer nofollow" aria-label="{{ 'general.social.links.youtube' | t | default: 'Follow on YouTube' }}">
                  <svg viewBox="0 0 576 512" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                    <path d="M549.7 124.1c-6.3-23.7-24.8-42.3-48.3-48.6C458.8 64 288 64 288 64S117.2 64 74.6 75.5c-23.5 6.3-42 24.9-48.3 48.6-11.4 42.9-11.4 132.3-11.4 132.3s0 89.4 11.4 132.3c6.3 23.7 24.8 41.5 48.3 47.8C117.2 448 288 448 288 448s170.8 0 213.4-11.5c23.5-6.3 42-24.2 48.3-47.8 11.4-42.9 11.4-132.3 11.4-132.3s0-89.4-11.4-132.3zm-317.5 213.5V175.2l142.7 81.2-142.7 81.2z"/>
                  </svg>
                </a>
              </li>
            {%- endif -%}

            {%- if show_tt and tt_url != blank -%}
              <li>
                <a href="{{ tt_url }}" class="bloom-footer__social-link" target="_blank" rel="noopener noreferrer nofollow" aria-label="{{ 'general.social.links.tiktok' | t | default: 'Follow on TikTok' }}">
                  <svg viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                    <path d="M448 209.9a210.1 210.1 0 0 1 -122.8-39.3V349.4A162.6 162.6 0 1 1 185 188.3V278.2a74.6 74.6 0 1 0 52.2 71.2V0l88 0a121.2 121.2 0 0 0 1.9 22.2h0A122.2 122.2 0 0 0 381 102.4a121.4 121.4 0 0 0 67 20.1z"/>
                  </svg>
                </a>
              </li>
            {%- endif -%}

            {%- if show_x and x_url != blank -%}
              <li>
                <a href="{{ x_url }}" class="bloom-footer__social-link" target="_blank" rel="noopener noreferrer nofollow" aria-label="Follow on X (Twitter)">
                  <svg viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                    <path d="M389.2 48h70.6L305.6 224.2 487 464H345L233.7 318.6 106.5 464H35.8L200.7 275.5 26.8 48H172.4L272.9 180.9 389.2 48zM364.4 421.8h39.1L151.1 88h-42L364.4 421.8z"/>
                  </svg>
                </a>
              </li>
            {%- endif -%}

          </ul>
        {%- endif -%}

        {%- comment -%}Localization Selectors (Shopify-native){%- endcomment -%}
        {%- if show_country or show_language -%}
          <div class="bloom-footer__localization">
            {%- form 'localization', id: 'bloom-footer-localization', class: 'bloom-footer__locale-form' -%}

              {%- if show_country and localization.available_countries.size > 1 -%}
                <div class="bloom-footer__locale-select-wrap">
                  <label class="sr-only" for="bloom-footer-country-{{ section.id }}">
                    {{- 'localization.country_label' | t | default: 'Country/Region' -}}
                  </label>
                  <select
                    id="bloom-footer-country-{{ section.id }}"
                    name="country_code"
                    class="bloom-footer__locale-select"
                    aria-label="{{ 'localization.country_label' | t | default: 'Country/Region' }}"
                  >
                    {%- for country in localization.available_countries -%}
                      <option
                        value="{{ country.iso_code }}"
                        {%- if country.iso_code == localization.country.iso_code %} selected{%- endif -%}
                      >
                        {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                      </option>
                    {%- endfor -%}
                  </select>
                  <span class="bloom-footer__locale-arrow" aria-hidden="true">
                    <svg viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path fill="currentColor" d="M9.396 0.5L10 1.135 5 6 0 1.135 0.604 0.5 5 4.73 9.396 0.5Z"/>
                    </svg>
                  </span>
                </div>
              {%- endif -%}

              {%- if show_language and localization.available_languages.size > 1 -%}
                <div class="bloom-footer__locale-select-wrap">
                  <label class="sr-only" for="bloom-footer-language-{{ section.id }}">
                    {{- 'localization.language_label' | t | default: 'Language' -}}
                  </label>
                  <select
                    id="bloom-footer-language-{{ section.id }}"
                    name="locale_code"
                    class="bloom-footer__locale-select"
                    aria-label="{{ 'localization.language_label' | t | default: 'Language' }}"
                  >
                    {%- for language in localization.available_languages -%}
                      <option
                        value="{{ language.iso_code }}"
                        {%- if language.iso_code == localization.language.iso_code %} selected{%- endif -%}
                      >
                        {{ language.endonym_name }}
                      </option>
                    {%- endfor -%}
                  </select>
                  <span class="bloom-footer__locale-arrow" aria-hidden="true">
                    <svg viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path fill="currentColor" d="M9.396 0.5L10 1.135 5 6 0 1.135 0.604 0.5 5 4.73 9.396 0.5Z"/>
                    </svg>
                  </span>
                </div>
              {%- endif -%}

            {%- endform -%}
          </div>
        {%- endif -%}

      </div>{%- comment -%}/.bloom-footer__col--brand{%- endcomment -%}

      {%- comment -%}------- Column 2: Quick Links -------{%- endcomment -%}
      <div class="bloom-footer__col bloom-footer__col--quicklinks">
        <nav aria-labelledby="bf-ql-heading-{{ section.id }}">
          <h3 class="bloom-footer__nav-heading" id="bf-ql-heading-{{ section.id }}">
            {{- 'Quick links' -}}
          </h3>
          {%- if quicklinks_menu != blank -%}
            {%- assign ql_menu = linklists[quicklinks_menu] -%}
            {%- if ql_menu.links.size > 0 -%}
              <ul class="bloom-footer__nav-list" role="list">
                {%- for link in ql_menu.links -%}
                  <li>
                    <a href="{{ link.url }}" class="bloom-footer__nav-link"
                      {%- if link.active %} aria-current="page"{%- endif -%}
                    >
                      {{- link.title -}}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          {%- else -%}
            {%- comment -%}Fallback: show Shopify built-in policy links if no menu selected{%- endcomment -%}
            <ul class="bloom-footer__nav-list" role="list">
              {%- if shop.policies.terms_of_service != blank -%}
                <li><a href="{{ shop.policies.terms_of_service.url }}" class="bloom-footer__nav-link">{{ shop.policies.terms_of_service.title }}</a></li>
              {%- endif -%}
              {%- if shop.policies.refund_policy != blank -%}
                <li><a href="{{ shop.policies.refund_policy.url }}" class="bloom-footer__nav-link">{{ shop.policies.refund_policy.title }}</a></li>
              {%- endif -%}
              {%- if shop.policies.privacy_policy != blank -%}
                <li><a href="{{ shop.policies.privacy_policy.url }}" class="bloom-footer__nav-link">{{ shop.policies.privacy_policy.title }}</a></li>
              {%- endif -%}
              {%- if shop.policies.shipping_policy != blank -%}
                <li><a href="{{ shop.policies.shipping_policy.url }}" class="bloom-footer__nav-link">{{ shop.policies.shipping_policy.title }}</a></li>
              {%- endif -%}
            </ul>
          {%- endif -%}
        </nav>
      </div>

      {%- comment -%}------- Column 3: About Us -------{%- endcomment -%}
      <div class="bloom-footer__col bloom-footer__col--about">
        <nav aria-labelledby="bf-about-heading-{{ section.id }}">
          <h3 class="bloom-footer__nav-heading" id="bf-about-heading-{{ section.id }}">
            {{- 'About us' -}}
          </h3>
          {%- if about_menu != blank -%}
            {%- assign ab_menu = linklists[about_menu] -%}
            {%- if ab_menu.links.size > 0 -%}
              <ul class="bloom-footer__nav-list" role="list">
                {%- for link in ab_menu.links -%}
                  <li>
                    <a href="{{ link.url }}" class="bloom-footer__nav-link"
                      {%- if link.active %} aria-current="page"{%- endif -%}
                    >
                      {{- link.title -}}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          {%- endif -%}
        </nav>
      </div>

      {%- comment -%}------- Column 4: Newsletter -------{%- endcomment -%}
      <div class="bloom-footer__col bloom-footer__col--newsletter">

        {%- if nl_heading != blank -%}
          <h2 class="bloom-footer__newsletter-heading">{{ nl_heading }}</h2>
        {%- endif -%}

        {%- if nl_desc != blank -%}
          <p class="bloom-footer__newsletter-desc">{{ nl_desc }}</p>
        {%- endif -%}

        {%- comment -%}Shopify native newsletter form (contact form type = customer){%- endcomment -%}
        {%- assign nl_success = false -%}
        {%- if customer.email != blank -%}
          {%- comment -%}Already logged in — can use customer object{%- endcomment -%}
        {%- endif -%}

        {%- form 'customer', id: form_id, class: 'bloom-footer__newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="hidden" name="contact[id]" value="{{ form_id }}">

          {%- if form.posted_successfully? -%}
            <p class="bloom-footer__newsletter-message bloom-footer__newsletter-message--success" role="status">
              {%- if section.settings.newsletter_success_message != blank -%}
                {{ section.settings.newsletter_success_message }}
              {%- else -%}
                {{ 'newsletter.success' | t | default: "Thanks for subscribing! Check your email for a confirmation." }}
              {%- endif -%}
            </p>
          {%- elsif form.errors -%}
            <p class="bloom-footer__newsletter-message bloom-footer__newsletter-message--error" role="alert">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </p>
          {%- endif -%}

          {%- unless form.posted_successfully? -%}
            <div class="bloom-footer__newsletter-field">
              <label class="sr-only" for="{{ form_id }}-email">
                {{- nl_placeholder | default: 'Enter your email' -}}
              </label>
              <input
                id="{{ form_id }}-email"
                type="email"
                name="contact[email]"
                class="bloom-footer__newsletter-input"
                placeholder="{{ nl_placeholder | default: 'Enter your email' }}"
                value="{{ form.value }}"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                aria-required="true"
                required
              >
              <button
                type="submit"
                class="bloom-footer__newsletter-btn"
                name="commit"
                aria-label="{{ nl_btn_label | default: 'Subscribe' }}"
              >
                {{- nl_btn_label | default: 'SUBSCRIBE' -}}
              </button>
            </div>
          {%- endunless -%}

        {%- endform -%}

      </div>

    </div>{%- comment -%}/.bloom-footer__columns{%- endcomment -%}

    {%- comment -%}============================================================
      DIVIDER
    ============================================================{%- endcomment -%}
    <hr class="bloom-footer__divider" aria-hidden="true">

    {%- comment -%}============================================================
      BOTTOM ROW — Copyright + Payments
    ============================================================{%- endcomment -%}
    {%- if show_copyright or show_payments -%}
      <div class="bloom-footer__bottom">

        {%- if show_copyright -%}
          <p class="bloom-footer__copyright">
            &copy; {{ 'now' | date: '%Y' }},&nbsp;
            {%- if brand_name != blank -%}
              <a href="{{ routes.root_url }}">{{ brand_name }}</a>
            {%- else -%}
              <a href="{{ routes.root_url }}">{{ shop.name }}</a>
            {%- endif -%}
            &nbsp;&nbsp;<a href="https://www.shopify.com?utm_campaign=poweredby&utm_medium=shopify&utm_source=onlinestore" target="_blank" rel="nofollow noopener">Powered by Shopify</a>
          </p>
        {%- endif -%}

        {%- if show_payments -%}
          {%- assign payment_methods = shop.enabled_payment_types -%}
          {%- if payment_methods.size > 0 -%}
            <ul class="bloom-footer__payments" role="list" aria-label="{{ 'sections.footer.payment_methods' | t | default: 'Payment methods' }}">
              {%- for type in payment_methods -%}
                <li class="bloom-footer__payment-item">
                  {{ type | payment_type_svg_tag: class: 'bloom-footer__payment-icon', width: '38', height: '24' }}
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        {%- endif -%}

      </div>
    {%- endif -%}

  </div>{%- comment -%}/.bloom-footer__inner{%- endcomment -%}

  {%- comment -%}============================================================
    OVERSIZED DECORATIVE WORDMARK
  ============================================================{%- endcomment -%}
  {%- if show_wordmark and wordmark_text != blank -%}
    <div class="bloom-footer__wordmark-wrap" aria-hidden="true">
      <div class="bloom-footer__wordmark">{{ wordmark_text | upcase }}</div>
    </div>
  {%- endif -%}

</footer>

{% schema %}
{
  "name": "Bloom Planti Footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "class": "shopify-section-bloom-footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "text",
      "id": "brand_heading",
      "label": "Brand wordmark text",
      "default": "BLOOM"
    },
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Brand description",
      "default": "Bringing nature closer to your home with carefully curated plants and gardening essentials. We believe every space deserves a touch of green."
    },
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "checkbox",
      "id": "show_facebook",
      "label": "Show Facebook",
      "default": true
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "checkbox",
      "id": "show_instagram",
      "label": "Show Instagram",
      "default": true
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "checkbox",
      "id": "show_youtube",
      "label": "Show YouTube",
      "default": true
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "checkbox",
      "id": "show_tiktok",
      "label": "Show TikTok",
      "default": true
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "checkbox",
      "id": "show_x",
      "label": "Show X (Twitter)",
      "default": true
    },
    {
      "type": "url",
      "id": "x_url",
      "label": "X (Twitter) URL"
    },
    {
      "type": "header",
      "content": "Localization"
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "Show country/region selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_language_selector",
      "label": "Show language selector",
      "default": true
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "quicklinks_menu",
      "label": "Quick links menu",
      "default": "footer"
    },
    {
      "type": "link_list",
      "id": "about_menu",
      "label": "About us menu",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
