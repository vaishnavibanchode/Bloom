{{ 'athora-planti-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'athora-planti-sections.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign color_scheme = section_st.color_scheme
  if section_st.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
  assign scroll_animation = settings.scroll_animation
  assign heading = section_st.heading
  assign description = section_st.description
  assign header_size = ''
  if section_st.header_size == 'small'
    assign header_size = 'h3'
  elsif section_st.header_size == 'large'
    assign header_size = 'h1-size'
  endif
-%}

{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}px; --section-pb: {{ section_st.padding_bottom }}px;
{%- endcapture -%}

<div
  class="section{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} sec__eco-stats-marquee color-{{ color_scheme }} gradient{{ reset_spacing }}"
  style="{{ style | strip | strip_newlines }}"
  data-section-id="{{ section.id }}"
>
  <!-- Continuous Athora Infinite Marquee Ribbon -->
  {%- if section_st.enable_marquee -%}
    <div class="planti-marquee-wrap" aria-label="Eco commitments marquee">
      <div class="planti-marquee-track">
        {%- for i in (1..3) -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'marquee_item' -%}
              <div class="planti-marquee-item" {{ block.shopify_attributes }}>
                <span class="planti-marquee-text">{{ block.settings.text }}</span>
                <span class="planti-marquee-divider" aria-hidden="true">✦</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  <!-- Animated Milestone Counters Grid -->
  <div class="{{ section_width }} planti-section-inner">
    {%- if heading != blank or description != blank -%}
      <div class="section__header mb-40 text-{{ section_st.header_alignment }}">
        {%- if heading != blank -%}
          <motion-element
            data-motion="fade-up-lg"
            data-motion-delay="50"
            {% if scroll_animation != 'slide_in' %}
              hold
            {% endif %}
            class="block {% if scroll_animation != 'none' %} scroll-trigger {{ scroll_animation }}{% endif %}"
            style="{%- if scroll_animation != 'none' -%}--animation-order: 0;{%- endif -%}"
          >
            <h2 class="section__header-heading heading-letter-spacing {{ header_size }} planti-editorial-heading mt-0{% if description != blank %} mb-10{% else %} mb-0{% endif %}">
              {{ heading }}
            </h2>
          </motion-element>
        {%- endif -%}
        {%- if description != blank -%}
          <motion-element
            data-motion="fade-up-lg"
            data-motion-delay="150"
            {% if scroll_animation != 'slide_in' %}
              hold
            {% endif %}
            class="block {% if scroll_animation != 'none' %} scroll-trigger {{ scroll_animation }}{% endif %}"
            style="{%- if scroll_animation != 'none' -%}--animation-order: 1;{%- endif -%}"
          >
            <div class="section__header-des rich__text-m0 body-text color-secondary fs-16 line-height-relaxed">
              {{ description }}
            </div>
          </motion-element>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="row g-20 planti-stat-grid" data-planti-stat-grid>
      {%- assign stat_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'stat_counter' -%}
          {%- assign stat_index = stat_index | plus: 1 -%}
          <div class="col-12 col-sm-6 col-lg-3" {{ block.shopify_attributes }}>
            <motion-element
              data-motion="fade-up-lg"
              data-motion-delay="{{ stat_index | times: 100 }}"
              {% if scroll_animation != 'slide_in' %}
                hold
              {% endif %}
              class="block {% if scroll_animation != 'none' %} scroll-trigger {{ scroll_animation }}{% endif %}"
              style="{%- if scroll_animation != 'none' -%}--animation-order: {{ stat_index | plus: 1 }};{%- endif -%}"
            >
              <div class="planti-stat-card">
                {%- assign stat_num = block.settings.number | default: block.settings.target_number | default: '50' -%}
                {%- assign stat_sub = block.settings.subtext | default: block.settings.subtitle -%}
                <div
                  class="planti-stat-number"
                  data-counter-target="{{ stat_num }}"
                  data-counter-suffix="{{ block.settings.suffix }}"
                  data-counter-prefix="{{ block.settings.prefix }}"
                >
                  <span class="planti-stat-prefix">{{ block.settings.prefix }}</span>
                  <span class="planti-stat-val">{{ stat_num }}</span>
                  <span class="planti-stat-suffix">{{ block.settings.suffix }}</span>
                </div>
                <h4 class="planti-stat-title fs-16 font-semibold mb-6">
                  {{ block.settings.title }}
                </h4>
                <p class="planti-stat-desc fs-14 color-secondary m-0 line-height-relaxed">
                  {{ stat_sub }}
                </p>
              </div>
            </motion-element>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Eco-Stats & Marquee",
  "tag": "section",
  "class": "section-eco-stats-marquee",
  "settings": [
    {
      "type": "header",
      "content": "Marquee Ribbon Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_marquee",
      "label": "Enable Infinite Marquee Ticker",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.section_header.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.section_header.heading.label",
      "default": "Our Growing Impact"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.all.section_header.description.label",
      "default": "<p>Cultivating sustainability and wellness across thousands of living spaces nationwide.</p>"
    },
    {
      "type": "select",
      "id": "header_size",
      "label": "t:sections.all.section_header.header_size.label",
      "default": "large",
      "options": [
        { "value": "small", "label": "t:sections.all.section_header.header_size.small.label" },
        { "value": "medium", "label": "t:sections.all.section_header.header_size.medium.label" },
        { "value": "large", "label": "t:sections.all.section_header.header_size.large.label" }
      ]
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "t:sections.all.section_header.alignment.label",
      "default": "center",
      "options": [
        { "value": "left", "label": "t:sections.all.section_header.alignment.left.label" },
        { "value": "center", "label": "t:sections.all.section_header.alignment.center.label" },
        { "value": "right", "label": "t:sections.all.section_header.alignment.right.label" }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:sections.all.section_width.label",
      "default": "container",
      "options": [
        { "value": "container", "label": "t:sections.all.section_width.container.label" },
        { "value": "fluid_container", "label": "t:sections.all.section_width.fluid_container.label" },
        { "value": "full_width", "label": "t:sections.all.section_width.full_width.label" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "default"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "default": 60,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 60,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "t:sections.all.reset_spacing.label",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "marquee_item",
      "name": "Marquee Text Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Ticker Text",
          "default": "100% Sustainably Nursery Grown"
        }
      ]
    },
    {
      "type": "stat_counter",
      "name": "Milestone Stat Counter",
      "settings": [
        {
          "type": "text",
          "id": "prefix",
          "label": "Prefix (e.g. $ or ★)"
        },
        {
          "type": "text",
          "id": "number",
          "label": "Target Number",
          "default": "50"
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Suffix (e.g. K+, %, ★)",
          "default": "K+"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Stat Title",
          "default": "Plants Delivered Safely"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Stat Subtitle",
          "default": "Carefully packaged with temperature monitoring"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Eco-Stats & Marquee",
      "blocks": [
        {
          "type": "marquee_item",
          "settings": { "text": "100% Sustainably Nursery Grown" }
        },
        {
          "type": "marquee_item",
          "settings": { "text": "Carbon Neutral Delivery Guarantee" }
        },
        {
          "type": "marquee_item",
          "settings": { "text": "Plastic-Free Biodegradable Packaging" }
        },
        {
          "type": "marquee_item",
          "settings": { "text": "Expert Lifetime Care Support" }
        },
        {
          "type": "stat_counter",
          "settings": {
            "number": "50",
            "suffix": "K+",
            "title": "Healthy Plants Shipped",
            "subtext": "Delivered in eco-friendly climate-controlled insulated boxes"
          }
        },
        {
          "type": "stat_counter",
          "settings": {
            "number": "99.4",
            "suffix": "%",
            "title": "Arrival Guarantee",
            "subtext": "Free replacement if any plant arrives unhappy"
          }
        },
        {
          "type": "stat_counter",
          "settings": {
            "number": "100",
            "suffix": "%",
            "title": "Plastic-Free Materials",
            "subtext": "Pots made from natural organic terracotta & coconut coir"
          }
        },
        {
          "type": "stat_counter",
          "settings": {
            "number": "4.9",
            "suffix": "★",
            "title": "Customer Rating",
            "subtext": "Trusted by over 15,000 botanical and indoor plant lovers"
          }
        }
      ]
    }
  ]
}
{% endschema %}
