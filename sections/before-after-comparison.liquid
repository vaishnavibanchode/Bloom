{{ 'athora-planti-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign color_scheme = section_st.color_scheme
  assign scroll_animation = settings.scroll_animation
-%}

{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}px; --section-pb: {{ section_st.padding_bottom }}px;
{%- endcapture -%}

<div
  class="section planti-before-after-section color-{{ color_scheme }} gradient"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="{{ section_width }} py-40 py-md-60">
    {%- if section_st.heading != blank or section_st.description != blank -%}
      <div class="section__header text-center mb-35">
        {%- if section_st.heading != blank -%}
          <motion-element
            data-motion="fade-up-lg"
            data-motion-delay="50"
            class="block {% if scroll_animation != 'none' %} scroll-trigger {{ scroll_animation }}{% endif %}"
          >
            <h2 class="section__header-heading h1 mb-10">
              {{ section_st.heading }}
            </h2>
          </motion-element>
        {%- endif -%}
        {%- if section_st.description != blank -%}
          <motion-element
            data-motion="fade-up-lg"
            data-motion-delay="150"
            class="block {% if scroll_animation != 'none' %} scroll-trigger {{ scroll_animation }}{% endif %}"
          >
            <p class="section__header-des body-text color-secondary fs-16 m-0">
              {{ section_st.description }}
            </p>
          </motion-element>
        {%- endif -%}
      </div>
    {%- endif -%}

    <motion-element
      data-motion="fade-up-lg"
      data-motion-delay="250"
      class="block {% if scroll_animation != 'none' %} scroll-trigger {{ scroll_animation }}{% endif %}"
    >
      <div
        class="planti-ba-container"
        data-planti-ba-slider
      >
        <!-- After Layer (Background) -->
        <div class="planti-ba-layer planti-ba-layer--after">
          {%- if section_st.image_after != blank -%}
            {{
              section_st.image_after
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                class: 'planti-ba-image',
                widths: '550, 750, 1100, 1500, 2000',
                alt: section_st.label_after
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'planti-ba-image placeholder-svg' }}
          {%- endif -%}
          <span class="planti-ba-label planti-ba-label--after">{{ section_st.label_after }}</span>
        </div>

        <!-- Before Layer (Clipped Top Layer) -->
        <div class="planti-ba-layer planti-ba-layer--before" data-planti-ba-before>
          {%- if section_st.image_before != blank -%}
            {{
              section_st.image_before
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                class: 'planti-ba-image',
                widths: '550, 750, 1100, 1500, 2000',
                alt: section_st.label_before
            }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'planti-ba-image placeholder-svg' }}
          {%- endif -%}
          <span class="planti-ba-label planti-ba-label--before">{{ section_st.label_before }}</span>
        </div>

        <!-- Slider Drag Handle -->
        <div class="planti-ba-handle" data-planti-ba-handle>
          <div class="planti-ba-handle__btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="15 18 9 12 15 6"></polyline>
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </div>
        </div>
      </div>
    </motion-element>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const baSliders = document.querySelectorAll('[data-planti-ba-slider]');
    baSliders.forEach((container) => {
      const beforeLayer = container.querySelector('[data-planti-ba-before]');
      const handle = container.querySelector('[data-planti-ba-handle]');
      let isDragging = false;

      function updateSliderPosition(clientX) {
        const rect = container.getBoundingClientRect();
        let offsetX = clientX - rect.left;
        if (offsetX < 0) offsetX = 0;
        if (offsetX > rect.width) offsetX = rect.width;
        const percentage = (offsetX / rect.width) * 100;
        beforeLayer.style.width = percentage + '%';
        handle.style.left = percentage + '%';
      }

      function onPointerDown(e) {
        isDragging = true;
        updateSliderPosition(e.clientX || e.touches[0].clientX);
      }

      function onPointerMove(e) {
        if (!isDragging) return;
        updateSliderPosition(e.clientX || (e.touches && e.touches[0].clientX));
      }

      function onPointerUp() {
        isDragging = false;
      }

      container.addEventListener('mousedown', onPointerDown);
      window.addEventListener('mousemove', onPointerMove);
      window.addEventListener('mouseup', onPointerUp);

      container.addEventListener('touchstart', onPointerDown, { passive: true });
      window.addEventListener('touchmove', onPointerMove, { passive: true });
      window.addEventListener('touchend', onPointerUp);
    });
  });
</script>

{% schema %}
{
  "name": "Before / After Slider",
  "tag": "section",
  "class": "section-before-after-slider",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "default": "container",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "fluid_container", "label": "Fluid Container" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Witness The Botanical Growth"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Drag the slider to see how our organic plant care transforms growth over 90 days."
    },
    {
      "type": "image_picker",
      "id": "image_before",
      "label": "Before Image (Left Side)"
    },
    {
      "type": "text",
      "id": "label_before",
      "label": "Before Label",
      "default": "DAY 1 - ARRIVAL"
    },
    {
      "type": "image_picker",
      "id": "image_after",
      "label": "After Image (Right Side)"
    },
    {
      "type": "text",
      "id": "label_after",
      "label": "After Label",
      "default": "MONTH 3 - FULL BLOOM"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Before / After Slider",
      "settings": {
        "heading": "Witness The Botanical Growth",
        "label_before": "DAY 1 - ARRIVAL",
        "label_after": "MONTH 3 - FULL BLOOM"
      }
    }
  ]
}
{% endschema %}
