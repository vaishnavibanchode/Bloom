{{ 'athora-planti-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'athora-planti-sections.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign color_scheme = section_st.color_scheme
  if section_st.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
  assign scroll_animation = settings.scroll_animation
  assign heading = section_st.heading
  assign description = section_st.description
  assign header_size = ''
  if section_st.header_size == 'small'
    assign header_size = 'h3'
  elsif section_st.header_size == 'large'
    assign header_size = 'h1-size'
  endif
-%}

{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}px; --section-pb: {{ section_st.padding_bottom }}px;
{%- endcapture -%}

<div
  class="section{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} sec__before-after color-{{ color_scheme }} gradient{{ reset_spacing }}"
  style="{{ style | strip | strip_newlines }}"
  data-section-id="{{ section.id }}"
>
  <div class="{{ section_width }} planti-section-inner">
    {%- if heading != blank or description != blank -%}
      <div class="section__header mb-35 text-{{ section_st.header_alignment }}">
        {%- if heading != blank -%}
          <motion-element
            data-motion="fade-up-lg"
            data-motion-delay="50"
            {% if scroll_animation != 'slide_in' %}
              hold
            {% endif %}
            class="block {% if scroll_animation != 'none' %} scroll-trigger {{ scroll_animation }}{% endif %}"
            style="{%- if scroll_animation != 'none' -%}--animation-order: 0;{%- endif -%}"
          >
            <h2 class="section__header-heading heading-letter-spacing {{ header_size }} planti-editorial-heading mt-0{% if description != blank %} mb-10{% else %} mb-0{% endif %}">
              {{ heading }}
            </h2>
          </motion-element>
        {%- endif -%}
        {%- if description != blank -%}
          <motion-element
            data-motion="fade-up-lg"
            data-motion-delay="150"
            {% if scroll_animation != 'slide_in' %}
              hold
            {% endif %}
            class="block {% if scroll_animation != 'none' %} scroll-trigger {{ scroll_animation }}{% endif %}"
            style="{%- if scroll_animation != 'none' -%}--animation-order: 1;{%- endif -%}"
          >
            <div class="section__header-des rich__text-m0 body-text color-secondary fs-16 line-height-relaxed">
              {{ description }}
            </div>
          </motion-element>
        {%- endif -%}
      </div>
    {%- endif -%}

    <motion-element
      data-motion="fade-up-lg"
      data-motion-delay="200"
      {% if scroll_animation != 'slide_in' %}
        hold
      {% endif %}
      class="block {% if scroll_animation != 'none' %} scroll-trigger {{ scroll_animation }}{% endif %}"
      style="{%- if scroll_animation != 'none' -%}--animation-order: 2;{%- endif -%}"
    >
      <div
        class="planti-ba-container"
        data-planti-ba-slider
        style="--initial-pos: {{ section_st.initial_position | default: 50 }}%;"
      >
        <!-- After Layer (Full Width Base Layer) -->
        <div class="planti-ba-layer planti-ba-layer--after">
          {%- if section_st.image_after != blank -%}
            {{
              section_st.image_after
              | image_url: width: 1800
              | image_tag:
                loading: 'lazy',
                class: 'planti-ba-image',
                widths: '550, 750, 1100, 1500, 1800',
                alt: section_st.label_after | default: 'After Growth'
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'planti-ba-image placeholder-svg' }}
          {%- endif -%}
          <span class="planti-ba-label planti-ba-label--after">{{ section_st.label_after | default: 'Month 3 - Full Bloom' }}</span>
        </div>

        <!-- Before Layer (Clipped Movable Top Layer) -->
        <div class="planti-ba-layer planti-ba-layer--before" data-planti-ba-before style="width: {{ section_st.initial_position | default: 50 }}%;">
          {%- if section_st.image_before != blank -%}
            {{
              section_st.image_before
              | image_url: width: 1800
              | image_tag:
                loading: 'lazy',
                class: 'planti-ba-image',
                widths: '550, 750, 1100, 1500, 1800',
                alt: section_st.label_before | default: 'Day 1 Arrival'
            }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'planti-ba-image placeholder-svg' }}
          {%- endif -%}
          <span class="planti-ba-label planti-ba-label--before">{{ section_st.label_before | default: 'Day 1 - Arrival' }}</span>
        </div>

        <!-- Draggable Handle Bar -->
        <div
          class="planti-ba-handle"
          data-planti-ba-handle
          style="left: {{ section_st.initial_position | default: 50 }}%;"
          role="slider"
          aria-valuenow="{{ section_st.initial_position | default: 50 }}"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-label="Drag before and after plant comparison"
          tabindex="0"
        >
          <div class="planti-ba-handle__btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </div>
        </div>
      </div>
    </motion-element>
  </div>
</div>

{% schema %}
{
  "name": "Before / After Comparison",
  "tag": "section",
  "class": "section-before-after-comparison",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.section_header.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.section_header.heading.label",
      "default": "Witness The Botanical Growth"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.all.section_header.description.label",
      "default": "<p>Drag the slider to see how our organic plant care transforms indoor foliage over 90 days.</p>"
    },
    {
      "type": "select",
      "id": "header_size",
      "label": "t:sections.all.section_header.header_size.label",
      "default": "large",
      "options": [
        { "value": "small", "label": "t:sections.all.section_header.header_size.small.label" },
        { "value": "medium", "label": "t:sections.all.section_header.header_size.medium.label" },
        { "value": "large", "label": "t:sections.all.section_header.header_size.large.label" }
      ]
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "t:sections.all.section_header.alignment.label",
      "default": "center",
      "options": [
        { "value": "left", "label": "t:sections.all.section_header.alignment.left.label" },
        { "value": "center", "label": "t:sections.all.section_header.alignment.center.label" },
        { "value": "right", "label": "t:sections.all.section_header.alignment.right.label" }
      ]
    },
    {
      "type": "header",
      "content": "Comparison Images"
    },
    {
      "type": "image_picker",
      "id": "image_before",
      "label": "Before Image (Left Layer)"
    },
    {
      "type": "text",
      "id": "label_before",
      "label": "Before Pill Label",
      "default": "DAY 1 - ARRIVAL"
    },
    {
      "type": "image_picker",
      "id": "image_after",
      "label": "After Image (Right Layer)"
    },
    {
      "type": "text",
      "id": "label_after",
      "label": "After Pill Label",
      "default": "MONTH 3 - FULL BLOOM"
    },
    {
      "type": "range",
      "id": "initial_position",
      "label": "Initial Handle Position (%)",
      "min": 10,
      "max": 90,
      "step": 5,
      "default": 50,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:sections.all.section_width.label",
      "default": "container",
      "options": [
        { "value": "container", "label": "t:sections.all.section_width.container.label" },
        { "value": "fluid_container", "label": "t:sections.all.section_width.fluid_container.label" },
        { "value": "full_width", "label": "t:sections.all.section_width.full_width.label" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "default"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "default": 60,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 60,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "t:sections.all.reset_spacing.label",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Before / After Comparison",
      "settings": {
        "heading": "Witness The Botanical Growth",
        "description": "<p>Drag the slider to see how our organic plant care transforms indoor foliage over 90 days.</p>",
        "label_before": "DAY 1 - ARRIVAL",
        "label_after": "MONTH 3 - FULL BLOOM"
      }
    }
  ]
}
{% endschema %}
