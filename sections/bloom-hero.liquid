{{ 'bloom-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bloom-hero.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign section_st = section.settings
  assign color_scheme = section_st.color_scheme
  assign hero_height = section_st.hero_height
  assign section_width = section_st.section_width
  assign content_alignment = section_st.content_alignment
  assign content_vertical_position = section_st.content_vertical_position
  assign enable_overlay = section_st.enable_overlay
  assign overlay_color = section_st.overlay_color
  assign overlay_opacity = section_st.overlay_opacity | divided_by: 100.0
  assign enable_gradient = section_st.enable_gradient
  assign gradient_direction = section_st.gradient_direction
  assign autoplay = section_st.enable_autoplay
  assign autoplay_interval = section_st.autoplay_interval
  assign show_pagination = section_st.show_pagination
  assign transition_duration = section_st.transition_duration
-%}

{%- if section_st.enable_section and section.blocks.size > 0 -%}
  <bloom-hero
    id="bloom-hero-{{ section.id }}"
    class="bloom-hero bloom-hero--h-{{ hero_height }}{% if section_width == 'full_bleed' %} bloom-hero--full-bleed{% else %} bloom-hero--container{% endif %} color-{{ color_scheme }}{% if section_st.enable_shrink_on_scroll %} bloom-hero--has-shrink{% endif %}"
    role="region"
    aria-roledescription="carousel"
    aria-label="Featured Botanical Slideshow"
    data-section-id="{{ section.id }}"
    data-autoplay="{{ autoplay }}"
    data-interval="{{ autoplay_interval }}"
    data-transition="{{ transition_duration }}"
    data-animation="{{ section_st.slide_animation | default: 'slide' }}"
    data-shrink="{{ section_st.enable_shrink_on_scroll }}"
    style="
      --bloom-hero-h-desktop: {{ section_st.desktop_custom_height }}px;
      --bloom-hero-h-mobile: {{ section_st.mobile_custom_height }}px;
      --bloom-content-mw: {{ section_st.content_max_width }}px;
      --bloom-text-align: {{ content_alignment }};
      --bloom-btn-justify: {% if content_alignment == 'left' %}flex-start{% elsif content_alignment == 'right' %}flex-end{% else %}center{% endif %};
      --bloom-overlay-color: {{ overlay_color }};
      --bloom-overlay-opacity: {{ overlay_opacity }};
      --bloom-heading-sz: {{ section_st.heading_font_size_desktop }}px;
      --bloom-heading-sz-mb: {{ section_st.heading_font_size_mobile }}px;
      --bloom-heading-lh: {{ section_st.heading_line_height }};
      --bloom-heading-color: {{ section_st.heading_color }};
      --bloom-italic-color: {{ section_st.italic_heading_color }};
      --bloom-desc-sz: {{ section_st.description_font_size_desktop }}px;
      --bloom-desc-sz-mb: {{ section_st.description_font_size_mobile }}px;
      --bloom-desc-color: {{ section_st.description_color }};
      --bloom-gap: {{ section_st.space_between_elements }}px;
      --bloom-btn-bg: {{ section_st.btn_bg_color }};
      --bloom-btn-text: {{ section_st.btn_text_color }};
      --bloom-btn-border: {{ section_st.btn_border_color }};
      --bloom-btn-hover-bg: {{ section_st.btn_hover_bg_color }};
      --bloom-btn-hover-text: {{ section_st.btn_hover_text_color }};
      --bloom-btn-radius: {{ section_st.btn_radius }}px;
      --bloom-btn-font-sz: {{ section_st.btn_font_size }}px;
      --bloom-transition-dur: {{ transition_duration }}ms;
    "
  >
    <div class="bloom-hero__shrink-wrap">
      <div class="bloom-hero__shrink-inner">
        <div class="bloom-hero__track" aria-live="polite">
          {%- for block in section.blocks -%}
            {%- liquid
              assign block_st = block.settings
              assign desktop_image = block_st.image
              assign mobile_image = block_st.image_mobile | default: desktop_image
              assign focal_point = block_st.focal_point
              if focal_point == 'default' or focal_point == blank
                assign focal_point = section_st.desktop_focal_point
              endif

              assign slide_opacity = overlay_opacity
              if block_st.overlay_opacity_override > 0
                assign slide_opacity = block_st.overlay_opacity_override | divided_by: 100.0
              endif

              assign btn_url = block_st.button_link
              if btn_url == blank
                assign btn_url = routes.all_products_collection_url
              endif

              assign btn_url_2 = block_st.button_link_2
              if btn_url_2 == blank
                assign btn_url_2 = routes.all_products_collection_url
              endif
            -%}

            <div
              class="bloom-hero__slide{% if forloop.first %} is-active{% endif %}"
              data-index="{{ forloop.index0 }}"
              data-block-id="{{ block.id }}"
              role="group"
              aria-roledescription="slide"
              aria-label="Slide {{ forloop.index }} of {{ forloop.length }}"
              aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
              {{ block.shopify_attributes }}
            >
              <!-- Media Background -->
              <div class="bloom-hero__media-wrapper">
                {%- if block_st.html5_video != blank -%}
                  <video
                    class="bloom-hero__video"
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    poster="{{ desktop_image | image_url: width: 1920 }}"
                  >
                    <source src="{{ block_st.html5_video }}" type="video/mp4">
                  </video>
                {%- elsif desktop_image != blank -%}
                  <picture class="bloom-hero__picture">
                    {%- if mobile_image != blank and mobile_image != desktop_image -%}
                      <source
                        media="(max-width: 767px)"
                        srcset="
                          {{ mobile_image | image_url: width: 480 }} 480w,
                          {{ mobile_image | image_url: width: 750 }} 750w,
                          {{ mobile_image | image_url: width: 1000 }} 1000w
                        "
                        sizes="100vw"
                      >
                    {%- endif -%}
                    <img
                      src="{{ desktop_image | image_url: width: 1920 }}"
                      srcset="
                        {{ desktop_image | image_url: width: 600 }} 600w,
                        {{ desktop_image | image_url: width: 900 }} 900w,
                        {{ desktop_image | image_url: width: 1200 }} 1200w,
                        {{ desktop_image | image_url: width: 1600 }} 1600w,
                        {{ desktop_image | image_url: width: 2000 }} 2000w,
                        {{ desktop_image | image_url: width: 2560 }} 2560w
                      "
                      sizes="100vw"
                      alt="{{ desktop_image.alt | default: block_st.heading | escape }}"
                      class="bloom-hero__image"
                      loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                      fetchpriority="{% if forloop.first %}high{% else %}auto{% endif %}"
                      style="--bloom-focal: {{ focal_point }};"
                    >
                  </picture>
                {%- else -%}
                  {%- liquid
                    assign fallback_mod = forloop.index | modulo: 2
                    if fallback_mod == 0
                      assign fallback_asset_name = 'bloom-hero-slide-2.jpg'
                    else
                      assign fallback_asset_name = 'bloom-hero-slide-1.jpg'
                    endif
                  -%}
                  <img
                    src="{{ fallback_asset_name | asset_url }}"
                    alt="{{ block_st.heading | default: 'Botanical greenhouse sanctuary' | escape }}"
                    class="bloom-hero__image"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    fetchpriority="{% if forloop.first %}high{% else %}auto{% endif %}"
                    style="--bloom-focal: {{ focal_point }};"
                    width="1920"
                    height="1080"
                  >
                {%- endif -%}
              </div>

              <!-- Overlay -->
              {%- if enable_overlay -%}
                <div
                  class="bloom-hero__overlay{% if enable_gradient %} bloom-hero__overlay--{{ gradient_direction }}{% endif %}"
                  style="--bloom-overlay-opacity: {{ slide_opacity }};"
                ></div>
              {%- endif -%}

              <!-- Content Area with Staggered Planti Reveal -->
              <div class="bloom-hero__content-box bloom-hero__content-box--{{ content_vertical_position }}" data-align="{{ content_alignment }}">
                <div class="bloom-hero__inner">
                  {%- if block_st.subheading != blank -%}
                    <div class="bloom-hero__eyebrow" can-reveal>
                      <span class="bloom-hero__eyebrow-text">{{ block_st.subheading }}</span>
                    </div>
                  {%- endif -%}

                  {%- if block_st.heading != blank -%}
                    {%- if forloop.first -%}
                      <h1 class="bloom-hero__heading" can-reveal>
                        {%- if block_st.highlighted_phrase != blank -%}
                          {{ block_st.heading }} <em>{{ block_st.highlighted_phrase }}</em>
                        {%- else -%}
                          {{ block_st.heading }}
                        {%- endif -%}
                      </h1>
                    {%- else -%}
                      <h2 class="bloom-hero__heading" can-reveal>
                        {%- if block_st.highlighted_phrase != blank -%}
                          {{ block_st.heading }} <em>{{ block_st.highlighted_phrase }}</em>
                        {%- else -%}
                          {{ block_st.heading }}
                        {%- endif -%}
                      </h2>
                    {%- endif -%}
                  {%- endif -%}

                  {%- if block_st.description != blank -%}
                    <div class="bloom-hero__description" can-reveal>
                      {{ block_st.description }}
                    </div>
                  {%- endif -%}

                  {%- if section_st.show_button and block_st.button_label != blank -%}
                    <div class="bloom-hero__cta-wrapper" can-reveal>
                      <a
                        href="{{ btn_url }}"
                        class="bloom-hero__btn bloom-hero__btn--primary"
                      >
                        <span class="bloom-hero__btn-inner">
                          <span>{{ block_st.button_label }}</span>
                          <span class="bloom-hero__circle-bg" aria-hidden="true"></span>
                        </span>
                      </a>
                      {%- if block_st.button_label_2 != blank -%}
                        <a
                          href="{{ btn_url_2 }}"
                          class="bloom-hero__btn bloom-hero__btn--secondary"
                        >
                          <span class="bloom-hero__btn-inner">
                            <span>{{ block_st.button_label_2 }}</span>
                            <span class="bloom-hero__circle-bg" aria-hidden="true"></span>
                          </span>
                        </a>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <!-- Planti SVG Progress Ring Pagination -->
        {%- if section.blocks.size > 1 and show_pagination -%}
          <div class="bloom-hero__pagination" role="tablist" aria-label="Slideshow pagination">
            {%- for block in section.blocks -%}
              <button
                type="button"
                class="bloom-hero__dot{% if forloop.first %} is-active{% endif %}"
                role="tab"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="Go to slide {{ forloop.index }}"
                data-index="{{ forloop.index0 }}"
              >
                <svg class="bloom-hero__progress-svg" viewBox="0 0 70 70" width="16" height="16" aria-hidden="true">
                  <path class="bloom-hero__progress-circle" d="m35,2.5c17.955803,0 32.5,14.544199 32.5,32.5c0,17.955803 -14.544197,32.5 -32.5,32.5c-17.955803,0 -32.5,-14.544197 -32.5,-32.5c0,-17.955801 14.544197,-32.5 32.5,-32.5z"></path>
                  <path class="bloom-hero__progress-path" d="m35,2.5c17.955803,0 32.5,14.544199 32.5,32.5c0,17.955803 -14.544197,32.5 -32.5,32.5c-17.955803,0 -32.5,-14.544197 -32.5,-32.5c0,-17.955801 14.544197,-32.5 32.5,-32.5z" pathLength="1"></path>
                </svg>
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <!-- Glassmorphic Navigation Chevrons -->
        {%- if section.blocks.size > 1 and section_st.show_arrows -%}
          <button
            type="button"
            class="bloom-hero__arrow bloom-hero__arrow--prev"
            aria-label="Previous slide"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button
            type="button"
            class="bloom-hero__arrow bloom-hero__arrow--next"
            aria-label="Next slide"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        {%- endif -%}
      </div>
    </div>
  </bloom-hero>
{%- endif -%}

{% schema %}
{
  "name": "Bloom Hero",
  "tag": "section",
  "class": "section-bloom-hero",
  "settings": [
    {
      "type": "header",
      "content": "General Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable Section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_shrink_on_scroll",
      "label": "Enable Shrink-On-Scroll (Athora Planti Effect)",
      "default": true,
      "info": "Smoothly frames the hero section with rounded corners as user scrolls down"
    },
    {
      "type": "select",
      "id": "slide_animation",
      "label": "Slideshow Transition",
      "default": "slide",
      "options": [
        {
          "value": "slide",
          "label": "Smooth Slide (Athora Planti Default)"
        },
        {
          "value": "fade",
          "label": "Cross Dissolve / Fade"
        }
      ]
    },
    {
      "type": "select",
      "id": "hero_height",
      "label": "Hero Height",
      "default": "100vh",
      "options": [
        {
          "value": "100vh",
          "label": "Viewport Height (100vh)"
        },
        {
          "value": "90vh",
          "label": "90% Viewport Height"
        },
        {
          "value": "75vh",
          "label": "75% Viewport Height"
        },
        {
          "value": "700px",
          "label": "700px"
        },
        {
          "value": "600px",
          "label": "600px"
        },
        {
          "value": "custom",
          "label": "Custom Height (Sliders Below)"
        }
      ]
    },
    {
      "type": "range",
      "id": "desktop_custom_height",
      "label": "Desktop Custom Height (px)",
      "min": 400,
      "max": 1000,
      "step": 20,
      "default": 760,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_custom_height",
      "label": "Mobile Custom Height (px)",
      "min": 320,
      "max": 800,
      "step": 20,
      "default": 540,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "default": "full_bleed",
      "options": [
        {
          "value": "full_bleed",
          "label": "Full Bleed (Edge to Edge)"
        },
        {
          "value": "container",
          "label": "Boxed Container"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "default"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content Maximum Width",
      "min": 500,
      "max": 1200,
      "step": 20,
      "default": 820,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Text Alignment",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_vertical_position",
      "label": "Content Vertical Position",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "Middle"
        },
        {
          "value": "top",
          "label": "Top Third"
        },
        {
          "value": "bottom",
          "label": "Bottom Third"
        }
      ]
    },
    {
      "type": "header",
      "content": "Image & Media Focal Settings"
    },
    {
      "type": "select",
      "id": "desktop_focal_point",
      "label": "Default Desktop Image Position",
      "default": "center center",
      "options": [
        {
          "value": "center center",
          "label": "Center Center"
        },
        {
          "value": "top center",
          "label": "Top Center"
        },
        {
          "value": "bottom center",
          "label": "Bottom Center"
        },
        {
          "value": "center left",
          "label": "Center Left"
        },
        {
          "value": "center right",
          "label": "Center Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Overlay Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_overlay",
      "label": "Enable Dark Botanical Overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Tint Color",
      "default": "#122119"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Default Overlay Opacity",
      "min": 0,
      "max": 80,
      "step": 1,
      "default": 28,
      "unit": "%"
    },
    {
      "type": "checkbox",
      "id": "enable_gradient",
      "label": "Enable Gradient Overlay",
      "default": true
    },
    {
      "type": "select",
      "id": "gradient_direction",
      "label": "Gradient Style",
      "default": "vertical",
      "options": [
        {
          "value": "vertical",
          "label": "Top & Bottom Vignette"
        },
        {
          "value": "bottom_up",
          "label": "Bottom to Top Contrast"
        },
        {
          "value": "vignette",
          "label": "Radial Vignette"
        }
      ]
    },
    {
      "type": "header",
      "content": "Typography Settings"
    },
    {
      "type": "range",
      "id": "heading_font_size_desktop",
      "label": "Desktop Heading Size",
      "min": 36,
      "max": 96,
      "step": 2,
      "default": 68,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Mobile Heading Size",
      "min": 24,
      "max": 54,
      "step": 2,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "heading_line_height",
      "label": "Heading Line Height",
      "default": "1.1",
      "options": [
        {
          "value": "1.05",
          "label": "Tight (1.05)"
        },
        {
          "value": "1.1",
          "label": "Normal (1.1)"
        },
        {
          "value": "1.18",
          "label": "Relaxed (1.18)"
        },
        {
          "value": "1.25",
          "label": "Open (1.25)"
        }
      ]
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "italic_heading_color",
      "label": "Highlighted / Italic Phrase Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "description_font_size_desktop",
      "label": "Desktop Supporting Text Size",
      "min": 14,
      "max": 24,
      "step": 1,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "description_font_size_mobile",
      "label": "Mobile Supporting Text Size",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 15,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Supporting Text Color",
      "default": "#f5f5f0"
    },
    {
      "type": "range",
      "id": "space_between_elements",
      "label": "Vertical Spacing Between Elements",
      "min": 10,
      "max": 40,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Call-To-Action Button"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Button",
      "default": true
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#183325"
    },
    {
      "type": "color",
      "id": "btn_border_color",
      "label": "Button Border Color",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "btn_hover_bg_color",
      "label": "Button Hover Background Color",
      "default": "#f0f7f0"
    },
    {
      "type": "color",
      "id": "btn_hover_text_color",
      "label": "Button Hover Text Color",
      "default": "#112319"
    },
    {
      "type": "range",
      "id": "btn_radius",
      "label": "Corner Radius (50px for Pill)",
      "min": 0,
      "max": 50,
      "step": 2,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "btn_font_size",
      "label": "Button Font Size",
      "min": 11,
      "max": 18,
      "step": 1,
      "default": 13,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Slideshow Controls"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Autoplay Change Every (Seconds)",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5,
      "unit": "s"
    },
    {
      "type": "range",
      "id": "transition_duration",
      "label": "Fade Transition Duration (ms)",
      "min": 400,
      "max": 1500,
      "step": 100,
      "default": 800,
      "unit": "ms"
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show Bottom Pagination Dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Navigation Arrows (Desktop)",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop Background Image",
          "info": "Recommended: 2000 x 1200px or larger high-resolution botanical photo"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile Background Image (Optional)",
          "info": "Falls back to desktop image if left empty"
        },
        {
          "type": "text",
          "id": "html5_video",
          "label": "Background Video URL (Optional MP4)",
          "info": "Direct MP4 link for looping background video"
        },
        {
          "type": "select",
          "id": "focal_point",
          "label": "Image Focal Alignment",
          "default": "default",
          "options": [
            {
              "value": "default",
              "label": "Use Section Default"
            },
            {
              "value": "center center",
              "label": "Center Center"
            },
            {
              "value": "top center",
              "label": "Top Center"
            },
            {
              "value": "bottom center",
              "label": "Bottom Center"
            },
