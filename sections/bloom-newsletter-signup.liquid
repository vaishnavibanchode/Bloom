{%- comment -%}
  Bloom Theme - Planti Preset Newsletter Subscription Section
  Faithful recreation of the Athora Planti signature newsletter component
{%- endcomment -%}

{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width | default: 'full_width'
  assign content_align = section_st.content_alignment | default: 'center'
  assign form_id = 'BloomNewsletterForm-' | append: section.id

  assign heading_content = section_st.heading
  if heading_content == blank
    assign heading_content = 'Subscribe to <em>our emails</em>'
  endif

  comment
    Auto-italicize specified phrase if merchant entered plain text without <em> or <i>
  endcomment
  if section_st.italic_text != blank
    unless heading_content contains '<em>' or heading_content contains '<i>' or heading_content contains '<em '
      if heading_content contains section_st.italic_text
        assign italic_tag = '<em>' | append: section_st.italic_text | append: '</em>'
        assign heading_content = heading_content | replace: section_st.italic_text, italic_tag
      endif
    endunless
  endif
-%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital,wght@0,400;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

  #shopify-section-{{ section.id }} {
    --bloom-nl-bg: {{ section_st.background_color | default: '#FAFAF0' }};
    --bloom-nl-h-color: {{ section_st.heading_color | default: '#294B3D' }};
    --bloom-nl-sub-color: {{ section_st.subtitle_color | default: '#294B3D' }};
    --bloom-nl-input-bg: {{ section_st.input_bg_color | default: '#FFFFFF' }};
    --bloom-nl-input-color: {{ section_st.input_text_color | default: '#294B3D' }};
    --bloom-nl-placeholder: {{ section_st.placeholder_color | default: '#94A69A' }};
    --bloom-nl-border: {{ section_st.input_border_color | default: '#E8ECE7' }};
    --bloom-nl-btn-bg: {{ section_st.button_bg_color | default: '#234638' }};
    --bloom-nl-btn-text: {{ section_st.button_text_color | default: '#FFFFFF' }};
    --bloom-nl-btn-hover-bg: {{ section_st.button_hover_bg_color | default: '#193629' }};

    --bloom-nl-pt-dk: {{ section_st.padding_top_desktop | default: 100 }}px;
    --bloom-nl-pb-dk: {{ section_st.padding_bottom_desktop | default: 100 }}px;
    --bloom-nl-pt-mb: {{ section_st.padding_top_mobile | default: 60 }}px;
    --bloom-nl-pb-mb: {{ section_st.padding_bottom_mobile | default: 60 }}px;

    --bloom-nl-h-sz-dk: {{ section_st.heading_size_desktop | default: 50 }}px;
    --bloom-nl-h-sz-mb: {{ section_st.heading_size_mobile | default: 34 }}px;
    --bloom-nl-sub-sz-dk: {{ section_st.subtitle_size_desktop | default: 22 }}px;
    --bloom-nl-sub-sz-mb: {{ section_st.subtitle_size_mobile | default: 16 }}px;
    --bloom-nl-btn-font-sz: {{ section_st.button_text_size | default: 13 }}px;

    --bloom-nl-gap-h-sub: {{ section_st.gap_heading_subtitle | default: 16 }}px;
    --bloom-nl-gap-sub-form: {{ section_st.gap_subtitle_form | default: 36 }}px;

    --bloom-nl-form-mw: {{ section_st.form_max_width | default: 555 }}px;
    --bloom-nl-form-h: {{ section_st.form_height | default: 72 }}px;
    --bloom-nl-btn-h: {{ section_st.button_height | default: 56 }}px;
    --bloom-nl-form-radius: {{ section_st.form_border_radius | default: 50 }}px;
    --bloom-nl-outer-radius: {{ section_st.outer_border_radius | default: 24 }}px;

    --bloom-nl-fixed-w: {{ section_st.fixed_container_width | default: 1200 }}px;
    --bloom-nl-content-mw: {{ section_st.content_max_width | default: 680 }}px;
  }

  /* Base section outer layout */
  .bloom-nl-section-{{ section.id }} {
    position: relative;
    width: 100%;
    box-sizing: border-box;
    overflow-x: clip;
    margin: 0;
    container-type: inline-size;
  }

  /* -------------------------------------------------------------
     Section Width Option 1: Full width
     - Ivory background extends 100% edge-to-edge
     - Content remains centered and bounded
     ------------------------------------------------------------- */
  .bloom-nl-section-{{ section.id }}.bloom-nl--full_width {
    background-color: var(--bloom-nl-bg);
  }
  .bloom-nl-section-{{ section.id }}.bloom-nl--full_width .bloom-nl__container {
    width: 100%;
    max-width: 100%;
    padding-left: clamp(16px, 4vw, 40px);
    padding-right: clamp(16px, 4vw, 40px);
    margin-inline: auto;
    box-sizing: border-box;
    padding-top: var(--bloom-nl-pt-dk);
    padding-bottom: var(--bloom-nl-pb-dk);
  }

  /* -------------------------------------------------------------
     Section Width Option 2: Default
     - Reuses theme's standard page-width / content-container
     - Follows theme gutters and maximum width
     ------------------------------------------------------------- */
  .bloom-nl-section-{{ section.id }}.bloom-nl--default {
    padding-left: var(--bs-gutter-x, 15px);
    padding-right: var(--bs-gutter-x, 15px);
    padding-top: 20px;
    padding-bottom: 20px;
  }
  .bloom-nl-section-{{ section.id }}.bloom-nl--default .bloom-nl__container {
    width: 100%;
    max-width: calc(var(--page-width, 1200px) + var(--bs-gutter-x, 15px) * 2);
    margin-inline: auto;
    background-color: var(--bloom-nl-bg);
    border-radius: var(--bloom-nl-outer-radius);
    box-sizing: border-box;
    padding-left: clamp(16px, 4vw, 40px);
    padding-right: clamp(16px, 4vw, 40px);
    padding-top: var(--bloom-nl-pt-dk);
    padding-bottom: var(--bloom-nl-pb-dk);
  }

  /* -------------------------------------------------------------
     Section Width Option 3: Fluid container
     - Responsive container expanding with viewport (95% up to 1440px+)
     - Balanced side margins
     ------------------------------------------------------------- */
  .bloom-nl-section-{{ section.id }}.bloom-nl--fluid_container {
    padding-left: var(--bs-gutter-x, 15px);
    padding-right: var(--bs-gutter-x, 15px);
    padding-top: 20px;
    padding-bottom: 20px;
  }
  .bloom-nl-section-{{ section.id }}.bloom-nl--fluid_container .bloom-nl__container {
    width: 95%;
    max-width: calc(var(--fluid-container-width, 1440px) + var(--bs-gutter-x, 15px) * 2);
    margin-inline: auto;
    background-color: var(--bloom-nl-bg);
    border-radius: var(--bloom-nl-outer-radius);
    box-sizing: border-box;
    padding-left: clamp(16px, 4vw, 40px);
    padding-right: clamp(16px, 4vw, 40px);
    padding-top: var(--bloom-nl-pt-dk);
    padding-bottom: var(--bloom-nl-pb-dk);
  }

  /* -------------------------------------------------------------
     Section Width Option 4: Fixed width
     - Configurable fixed width in pixels (e.g. 1200px)
     - Responsive constraint prevents horizontal overflow on mobile
     ------------------------------------------------------------- */
  .bloom-nl-section-{{ section.id }}.bloom-nl--fixed_width {
    padding-left: var(--bs-gutter-x, 15px);
    padding-right: var(--bs-gutter-x, 15px);
    padding-top: 20px;
    padding-bottom: 20px;
  }
  .bloom-nl-section-{{ section.id }}.bloom-nl--fixed_width .bloom-nl__container {
    width: 100%;
    max-width: min(100%, var(--bloom-nl-fixed-w));
    margin-inline: auto;
    background-color: var(--bloom-nl-bg);
    border-radius: var(--bloom-nl-outer-radius);
    box-sizing: border-box;
    padding-left: clamp(16px, 4vw, 40px);
    padding-right: clamp(16px, 4vw, 40px);
    padding-top: var(--bloom-nl-pt-dk);
    padding-bottom: var(--bloom-nl-pb-dk);
  }

  /* Optional full bleed background override for contained modes */
  .bloom-nl-section-{{ section.id }}.bloom-nl--bleed-bg {
    background-color: var(--bloom-nl-bg) !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }
  .bloom-nl-section-{{ section.id }}.bloom-nl--bleed-bg .bloom-nl__container {
    background-color: transparent !important;
    border-radius: 0 !important;
  }

  /* Centered Content Column */
  .bloom-nl__content {
    width: 100%;
    max-width: var(--bloom-nl-content-mw);
    margin-inline: auto;
    box-sizing: border-box;
  }
  .bloom-nl__content.text-center {
    text-align: center;
  }
  .bloom-nl__content.text-left {
    text-align: left;
  }

  /* Heading Typography */
  .bloom-nl__heading {
    margin: 0 0 var(--bloom-nl-gap-h-sub) 0;
    font-family: "Instrument Serif", "Georgia", serif;
    font-size: var(--bloom-nl-h-sz-dk);
    line-height: 1.15;
    font-weight: 400;
    font-style: normal;
    color: var(--bloom-nl-h-color);
    letter-spacing: -0.015em;
    -webkit-font-smoothing: antialiased;
  }
  .bloom-nl__heading em,
  .bloom-nl__heading i {
    font-family: "Instrument Serif", "Georgia", serif;
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  /* Subtitle Typography */
  .bloom-nl__subtitle {
    margin: 0 0 var(--bloom-nl-gap-sub-form) 0;
    font-family: var(--body-font, "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
    font-size: var(--bloom-nl-sub-sz-dk);
    line-height: 1.45;
    font-weight: 400;
    color: var(--bloom-nl-sub-color);
    letter-spacing: -0.01em;
    -webkit-font-smoothing: antialiased;
  }

  /* Form & Inner Pill Wrapper */
  .bloom-nl__form-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }
  .text-left .bloom-nl__form-wrapper {
    align-items: flex-start;
  }

  .bloom-nl__customer-form {
    width: 100%;
    max-width: var(--bloom-nl-form-mw);
    margin: 0 auto;
  }
  .text-left .bloom-nl__customer-form {
    margin: 0;
  }

  .bloom-nl__pill-group {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: var(--bloom-nl-form-h);
    background-color: var(--bloom-nl-input-bg);
    border: 1px solid var(--bloom-nl-border);
    border-radius: var(--bloom-nl-form-radius);
    padding: 8px 8px 8px 24px;
    box-sizing: border-box;
    box-shadow: 0 4px 20px rgba(41, 75, 61, 0.04);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .bloom-nl__pill-group:focus-within {
    border-color: rgba(35, 70, 56, 0.35);
    box-shadow: 0 6px 24px rgba(35, 70, 56, 0.08);
  }

  /* Email Input */
  .bloom-nl__input {
    flex: 1 1 auto;
    min-width: 0;
    height: 100%;
    border: none !important;
    outline: none !important;
    background: transparent !important;
    box-shadow: none !important;
    padding: 0 !important;
    margin: 0 !important;
    font-family: var(--body-font, "Plus Jakarta Sans", sans-serif);
    font-size: 16px;
    line-height: 1.2;
    color: var(--bloom-nl-input-color);
    -webkit-appearance: none;
  }
  .bloom-nl__input::placeholder {
    color: var(--bloom-nl-placeholder);
    opacity: 1;
    font-family: var(--body-font, "Plus Jakarta Sans", sans-serif);
    font-size: 16px;
    letter-spacing: normal;
  }
  .bloom-nl__input:focus {
    outline: none !important;
    box-shadow: none !important;
  }

  /* Subscribe Button */
  .bloom-nl__submit-btn {
    position: relative;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--bloom-nl-btn-h);
    min-width: 144px;
    padding: 0 28px;
    margin: 0;
    background-color: var(--bloom-nl-btn-bg);
    color: var(--bloom-nl-btn-text);
    border: none;
    border-radius: 9999px;
    font-family: var(--btn-font, var(--body-font, "Plus Jakarta Sans", sans-serif));
    font-size: var(--bloom-nl-btn-font-sz);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1;
    cursor: pointer;
    overflow: hidden;
    text-decoration: none;
    z-index: 1;
    transition: background-color 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s ease, box-shadow 0.2s ease;
    -webkit-font-smoothing: antialiased;
  }
  .bloom-nl__submit-btn:hover {
    background-color: var(--bloom-nl-btn-hover-bg);
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(35, 70, 56, 0.22);
  }
  .bloom-nl__submit-btn:active {
    transform: translateY(0);
    box-shadow: 0 2px 8px rgba(35, 70, 56, 0.15);
  }

  /* Planti Signature Expanding Circle Ripple Effect */
  .bloom-nl__circle-bg {
    position: absolute;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    transform: translate(-50%, -50%);
    transition: width 0.5s ease-out, height 0.5s ease-out;
    pointer-events: none;
    z-index: -1;
  }
  .bloom-nl__submit-btn:hover .bloom-nl__circle-bg {
    width: 320%;
    height: 320%;
  }

  /* Accessibility Screen Reader Only */
  .bloom-nl__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  /* Success & Error State Notifications */
  .bloom-nl__message {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    max-width: var(--bloom-nl-form-mw);
    padding: 14px 22px;
    border-radius: 9999px;
    font-family: var(--body-font, "Plus Jakarta Sans", sans-serif);
    font-size: 15px;
    font-weight: 500;
    box-sizing: border-box;
    margin-bottom: 16px;
    animation: bloomNlFadeIn 0.35s ease-out forwards;
  }
  .bloom-nl__message--success {
    background-color: #EBF4EE;
    color: #194C33;
    border: 1px solid #C4DEC9;
  }
  .bloom-nl__message--error {
    background-color: #FDF1F0;
    color: #BA1A1A;
    border: 1px solid #F5C6C6;
  }
  .bloom-nl__icon {
    flex-shrink: 0;
  }

  @keyframes bloomNlFadeIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* -------------------------------------------------------------
     Mobile & Tablet Responsiveness
     Dual Support: Media Queries & Container Queries
     Tested at 320px, 375px, 390px, 430px, 768px, 1024px, 1440px
     ------------------------------------------------------------- */
  @media screen and (max-width: 768px) {
    .bloom-nl-section-{{ section.id }}.bloom-nl--full_width .bloom-nl__container,
    .bloom-nl-section-{{ section.id }}.bloom-nl--default .bloom-nl__container,
    .bloom-nl-section-{{ section.id }}.bloom-nl--fluid_container .bloom-nl__container,
    .bloom-nl-section-{{ section.id }}.bloom-nl--fixed_width .bloom-nl__container {
      padding-top: var(--bloom-nl-pt-mb);
      padding-bottom: var(--bloom-nl-pb-mb);
      padding-left: clamp(12px, 4vw, 20px);
      padding-right: clamp(12px, 4vw, 20px);
    }

    .bloom-nl__heading {
      font-size: clamp(28px, 6vw, var(--bloom-nl-h-sz-mb));
      line-height: 1.18;
      overflow-wrap: break-word;
    }

    .bloom-nl__subtitle {
      font-size: clamp(14px, 3.8vw, var(--bloom-nl-sub-sz-mb));
      line-height: 1.45;
    }

    .bloom-nl__pill-group {
      height: clamp(52px, 14vw, 60px);
      padding: 5px 5px 5px clamp(12px, 3.5vw, 18px);
    }

    .bloom-nl__input {
      font-size: clamp(12.5px, 3.5vw, 14px);
    }
    .bloom-nl__input::placeholder {
      font-size: clamp(12.5px, 3.5vw, 14px);
    }

    .bloom-nl__submit-btn {
      height: clamp(42px, 12vw, 48px);
      min-width: clamp(86px, 24vw, 114px);
      padding: 0 clamp(10px, 2.5vw, 18px);
      font-size: clamp(10.5px, 2.8vw, 12px);
      letter-spacing: 0.05em;
    }
  }

  @container (max-width: 768px) {
    .bloom-nl__container {
      padding-top: var(--bloom-nl-pt-mb) !important;
      padding-bottom: var(--bloom-nl-pb-mb) !important;
      padding-left: clamp(12px, 4vw, 20px) !important;
      padding-right: clamp(12px, 4vw, 20px) !important;
    }

    .bloom-nl__heading {
      font-size: clamp(28px, 6cqw, var(--bloom-nl-h-sz-mb)) !important;
      line-height: 1.18 !important;
      overflow-wrap: break-word !important;
    }

    .bloom-nl__subtitle {
      font-size: clamp(14px, 3.8cqw, var(--bloom-nl-sub-sz-mb)) !important;
      line-height: 1.45 !important;
    }

    .bloom-nl__pill-group {
      height: clamp(52px, 14cqw, 60px) !important;
      padding: 5px 5px 5px clamp(12px, 3.5cqw, 18px) !important;
    }

    .bloom-nl__input {
      font-size: clamp(12.5px, 3.5cqw, 14px) !important;
    }
    .bloom-nl__input::placeholder {
      font-size: clamp(12.5px, 3.5cqw, 14px) !important;
    }

    .bloom-nl__submit-btn {
      height: clamp(42px, 12cqw, 48px) !important;
      min-width: clamp(86px, 24cqw, 114px) !important;
      padding: 0 clamp(10px, 2.5cqw, 18px) !important;
      font-size: clamp(10.5px, 2.8cqw, 12px) !important;
      letter-spacing: 0.05em !important;
    }
  }

  @media screen and (max-width: 360px) {
    .bloom-nl__heading {
      font-size: 27px;
    }
    .bloom-nl__subtitle {
      font-size: 13.5px;
    }
    .bloom-nl__pill-group {
      height: 50px;
      padding: 4px 4px 4px 12px;
    }
    .bloom-nl__submit-btn {
      height: 42px;
      min-width: 80px;
      padding: 0 10px;
      font-size: 10px;
    }
    .bloom-nl__input {
      font-size: 12px;
    }
    .bloom-nl__input::placeholder {
      font-size: 12px;
    }
  }

  @container (max-width: 360px) {
    .bloom-nl__heading {
      font-size: 27px !important;
    }
    .bloom-nl__subtitle {
      font-size: 13.5px !important;
    }
    .bloom-nl__pill-group {
      height: 50px !important;
      padding: 4px 4px 4px 12px !important;
    }
    .bloom-nl__submit-btn {
      height: 42px !important;
      min-width: 80px !important;
      padding: 0 10px !important;
      font-size: 10px !important;
    }
    .bloom-nl__input {
      font-size: 12px !important;
    }
    .bloom-nl__input::placeholder {
      font-size: 12px !important;
    }
  }
</style>

<section
  id="bloom-newsletter-{{ section.id }}"
  class="bloom-nl-section-{{ section.id }} bloom-nl--{{ section_width }}{% if section_st.background_full_bleed %} bloom-nl--bleed-bg{% endif %}"
  aria-label="{{ section_st.heading | default: 'Newsletter Subscription' | escape }}"
>
  <div class="bloom-nl__container">
    <div class="bloom-nl__content text-{{ content_align }}">
      {%- if heading_content != blank -%}
        <h2 class="bloom-nl__heading">
          {{ heading_content }}
        </h2>
      {%- endif -%}

      {%- if section_st.subtitle != blank -%}
        <p class="bloom-nl__subtitle">
          {{ section_st.subtitle }}
        </p>
      {%- endif -%}

      <div class="bloom-nl__form-wrapper">
        {%- form 'customer', class: 'bloom-nl__customer-form', id: form_id -%}
          <input type="hidden" name="contact[tags]" value="newsletter">

          {%- if form.posted_successfully? -%}
            <div
              class="bloom-nl__message bloom-nl__message--success"
              tabindex="-1"
              autofocus
              role="status"
            >
              <svg
                class="bloom-nl__icon"
                width="20"
                height="20"
                viewBox="0 0 20 20"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.5"/>
                <path d="M6 10.5L8.5 13L14 7.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>{{ section_st.success_message | default: 'Thank you for subscribing! Check your inbox for updates.' }}</span>
            </div>
          {%- else -%}
            {%- if form.errors -%}
              <div
                class="bloom-nl__message bloom-nl__message--error"
                role="alert"
                tabindex="-1"
              >
                <svg
                  class="bloom-nl__icon"
                  width="20"
                  height="20"
                  viewBox="0 0 20 20"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  aria-hidden="true"
                >
                  <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.5"/>
                  <line x1="10" y1="6" x2="10" y2="11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  <circle cx="10" cy="14" r="1" fill="currentColor"/>
                </svg>
                <span>
                  {{ form.errors.translated_fields.email | default: 'Email' | capitalize }}
                  {{ form.errors.messages.email }}
                </span>
              </div>
            {%- endif -%}

            <div class="bloom-nl__pill-group">
              <label for="BloomNewsletterInput-{{ section.id }}" class="bloom-nl__sr-only">
                {{ section_st.email_placeholder | default: 'Enter your email' }}
              </label>
              <input
                id="BloomNewsletterInput-{{ section.id }}"
                type="email"
                name="contact[email]"
                class="bloom-nl__input"
                value="{% if customer %}{{ customer.email }}{% endif %}"
                placeholder="{{ section_st.email_placeholder | default: 'Enter your email' }}"
                aria-label="{{ section_st.email_placeholder | default: 'Enter your email' }}"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                required
              >
              <button
                type="submit"
                name="commit"
                id="BloomNewsletterSubmit-{{ section.id }}"
                class="bloom-nl__submit-btn"
                aria-label="{{ section_st.button_label | default: 'SUBSCRIBE' }}"
              >
                <span class="bloom-nl__btn-text">{{ section_st.button_label | default: 'SUBSCRIBE' }}</span>
                <span class="bloom-nl__circle-bg" aria-hidden="true"></span>
              </button>
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

