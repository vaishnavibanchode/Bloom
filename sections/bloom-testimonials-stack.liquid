{%- comment -%}
  Bloom Theme - Planti Animated Testimonials Section
  Faithful recreation of the Athora Planti signature layered-photo testimonials component
{%- endcomment -%}

{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width | default: 'default'
  assign total_blocks = section.blocks.size
-%}

<style>
  #shopify-section-{{ section.id }} {
    --bloom-testi-outer-bg: {{ section_st.outer_background_color | default: '#FAFAF0' }};
    --bloom-testi-card-bg: {{ section_st.card_background_color | default: '#F0F0E1' }};
    --bloom-testi-text-color: {{ section_st.text_color | default: '#294B3D' }};
    --bloom-testi-quote-color: {{ section_st.quote_color | default: '#C7CEBE' }};
    --bloom-testi-star-color: {{ section_st.star_color | default: '#FF982D' }};
    --bloom-testi-verified-color: {{ section_st.verified_color | default: '#29965A' }};
    --bloom-testi-nav-bg: {{ section_st.nav_bg_color | default: '#FFFFFF' }};
    --bloom-testi-nav-icon: {{ section_st.nav_icon_color | default: '#294B3D' }};
    --bloom-testi-progress-track: {{ section_st.progress_track_color | default: '#E8ECE8' }};
    --bloom-testi-progress-bar: {{ section_st.progress_bar_color | default: '#294B3D' }};

    --bloom-testi-pt-dk: {{ section_st.padding_top_desktop | default: 80 }}px;
    --bloom-testi-pb-dk: {{ section_st.padding_bottom_desktop | default: 80 }}px;
    --bloom-testi-pt-mb: {{ section_st.padding_top_mobile | default: 50 }}px;
    --bloom-testi-pb-mb: {{ section_st.padding_bottom_mobile | default: 50 }}px;

    --bloom-testi-font-sz-dk: {{ section_st.review_font_size_desktop | default: 30 }}px;
    --bloom-testi-font-sz-mb: {{ section_st.review_font_size_mobile | default: 20 }}px;
    --bloom-testi-line-height: {{ section_st.review_line_height | default: 150 | divided_by: 100.0 }};

    --bloom-testi-stack-w: {{ section_st.stack_width_desktop | default: 420 }}px;
    --bloom-testi-card-radius: {{ section_st.card_corner_radius | default: 16 }}px;
    --bloom-testi-container-radius: {{ section_st.container_corner_radius | default: 24 }}px;
    --bloom-testi-col-gap: {{ section_st.column_gap_desktop | default: 70 }}px;

    --bloom-testi-fixed-w: {{ section_st.fixed_container_width | default: 1400 }}px;
    --bloom-testi-content-mw: {{ section_st.content_max_width | default: 1320 }}px;
    --bloom-testi-anim-dur: {{ section_st.animation_duration | default: 400 }}ms;
  }

  /* Section base */
  .bloom-testi-section-{{ section.id }} {
    position: relative;
    width: 100%;
    box-sizing: border-box;
    overflow-x: clip;
    background-color: var(--bloom-testi-outer-bg);
    container-type: inline-size;
  }

  /* Section Width Modes */
  .bloom-testi-section-{{ section.id }}.bloom-testi--full_width {
    padding: 0;
  }
  .bloom-testi-section-{{ section.id }}.bloom-testi--full_width .bloom-testi__outer {
    width: 100%;
    max-width: 100%;
    padding: 0;
  }
  .bloom-testi-section-{{ section.id }}.bloom-testi--full_width .bloom-testi__card {
    border-radius: 0;
  }

  .bloom-testi-section-{{ section.id }}.bloom-testi--default {
    padding-left: var(--bs-gutter-x, 15px);
    padding-right: var(--bs-gutter-x, 15px);
    padding-top: 24px;
    padding-bottom: 24px;
  }
  .bloom-testi-section-{{ section.id }}.bloom-testi--default .bloom-testi__outer {
    width: 100%;
    max-width: calc(var(--page-width, 1200px) + var(--bs-gutter-x, 15px) * 2);
    margin-inline: auto;
  }

  .bloom-testi-section-{{ section.id }}.bloom-testi--fluid_container {
    padding-left: var(--bs-gutter-x, 15px);
    padding-right: var(--bs-gutter-x, 15px);
    padding-top: 24px;
    padding-bottom: 24px;
  }
  .bloom-testi-section-{{ section.id }}.bloom-testi--fluid_container .bloom-testi__outer {
    width: 95%;
    max-width: calc(var(--fluid-container-width, 1440px) + var(--bs-gutter-x, 15px) * 2);
    margin-inline: auto;
  }

  .bloom-testi-section-{{ section.id }}.bloom-testi--fixed_width {
    padding-left: var(--bs-gutter-x, 15px);
    padding-right: var(--bs-gutter-x, 15px);
    padding-top: 24px;
    padding-bottom: 24px;
  }
  .bloom-testi-section-{{ section.id }}.bloom-testi--fixed_width .bloom-testi__outer {
    width: 100%;
    max-width: min(100%, var(--bloom-testi-fixed-w));
    margin-inline: auto;
  }

  /* Full Bleed Background Override for contained modes */
  .bloom-testi-section-{{ section.id }}.bloom-testi--bleed-bg {
    background-color: var(--bloom-testi-card-bg) !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }
  .bloom-testi-section-{{ section.id }}.bloom-testi--bleed-bg .bloom-testi__card {
    background-color: transparent !important;
    border-radius: 0 !important;
  }

  /* Main Card Container */
  .bloom-testi__card {
    position: relative;
    width: 100%;
    background-color: var(--bloom-testi-card-bg);
    border-radius: var(--bloom-testi-container-radius);
    padding-top: var(--bloom-testi-pt-dk);
    padding-bottom: var(--bloom-testi-pb-dk);
    padding-left: clamp(24px, 5vw, 64px);
    padding-right: clamp(24px, 5vw, 64px);
    box-sizing: border-box;
    overflow: hidden;
  }

  .bloom-testi__content-wrap {
    width: 100%;
    max-width: var(--bloom-testi-content-mw);
    margin-inline: auto;
    box-sizing: border-box;
  }

  /* Two Column Grid */
  .bloom-testi__grid {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--bloom-testi-col-gap);
    box-sizing: border-box;
  }

  /* Left Column: Image Stack */
  .bloom-testi__images-col {
    flex: 0 0 var(--bloom-testi-stack-w);
    max-width: var(--bloom-testi-stack-w);
    position: relative;
    box-sizing: border-box;
  }

  .bloom-testi__stack {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    display: grid;
  }

  .bloom-testi__photo-card {
    grid-area: 1 / -1;
    position: relative;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    will-change: transform, z-index;
    transform: translateZ(0);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    transition: transform var(--bloom-testi-anim-dur) cubic-bezier(0.25, 1, 0.5, 1);
  }

  .bloom-testi__photo-inner {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: var(--bloom-testi-card-radius);
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(41, 75, 61, 0.08);
    transform: rotate(var(--card-rotate, 0deg));
    transition: transform var(--bloom-testi-anim-dur) cubic-bezier(0.25, 1, 0.5, 1);
    background-color: #E8ECE8;
  }

  .bloom-testi__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
    user-select: none;
  }

  /* Right Column: Review Details */
  .bloom-testi__content-col {
    flex: 1 1 0%;
    min-width: 0;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Large Decorative Quotation Mark */
  .bloom-testi__quote-mark {
    display: flex;
    align-items: center;
    margin-bottom: 24px;
    color: var(--bloom-testi-quote-color);
  }
  .bloom-testi__quote-mark svg {
    width: 48px;
    height: 35px;
    fill: currentColor;
  }

  /* Slides Wrapper */
  .bloom-testi__slides {
    position: relative;
    width: 100%;
    min-height: 220px;
  }

  .bloom-testi__slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(-16px);
    transition: opacity var(--bloom-testi-anim-dur) cubic-bezier(0.25, 1, 0.5, 1),
                transform var(--bloom-testi-anim-dur) cubic-bezier(0.25, 1, 0.5, 1),
                visibility 0s linear var(--bloom-testi-anim-dur);
  }

  .bloom-testi__slide.is-active {
    position: relative;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(0);
    transition: opacity var(--bloom-testi-anim-dur) cubic-bezier(0.25, 1, 0.5, 1),
                transform var(--bloom-testi-anim-dur) cubic-bezier(0.25, 1, 0.5, 1),
                visibility 0s linear 0s;
  }

  /* Star Rating */
  .bloom-testi__stars {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 18px;
    color: var(--bloom-testi-star-color);
  }
  .bloom-testi__star {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }
  .bloom-testi__star.is-empty {
    opacity: 0.25;
  }

  /* Testimonial Quote Copy */
  .bloom-testi__quote-text {
    font-family: var(--body-font, "Plus Jakarta Sans", sans-serif);
    font-size: var(--bloom-testi-font-sz-dk);
    line-height: var(--bloom-testi-line-height);
    font-weight: 400;
    color: var(--bloom-testi-text-color);
    letter-spacing: -0.015em;
    margin: 0 0 24px 0;
  }

  /* Author Name & Verified Badge */
  .bloom-testi__author-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .bloom-testi__verified-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 15px;
    height: 15px;
    color: var(--bloom-testi-verified-color);
    flex-shrink: 0;
  }

  .bloom-testi__author-name {
    font-family: var(--body-font, "Plus Jakarta Sans", sans-serif);
    font-size: 16px;
    font-weight: 600;
    color: var(--bloom-testi-text-color);
    line-height: 1.2;
  }

  /* Purchased Items */
  .bloom-testi__purchased {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-family: var(--body-font, "Plus Jakarta Sans", sans-serif);
    font-size: 15px;
    color: var(--bloom-testi-text-color);
    margin-bottom: 32px;
  }

  .bloom-testi__purchased-label {
    opacity: 0.85;
    font-weight: 400;
  }

  .bloom-testi__product-hover-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .bloom-testi__product-link {
    font-weight: 700;
    color: var(--bloom-testi-text-color);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s ease;
  }
  .bloom-testi__product-link:hover {
    opacity: 0.75;
  }

  /* Product Floating Hover Tooltip */
  .bloom-testi__product-tooltip {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    width: 140px;
    height: 150px;
    background-color: #FFFFFF;
    border-radius: 12px;
    padding: 6px;
    box-shadow: 0 12px 32px rgba(41, 75, 61, 0.15);
    opacity: 0;
    pointer-events: none;
    z-index: 100;
    transition: opacity 0.25s ease, transform 0.25s ease;
    overflow: hidden;
  }
  .bloom-testi__product-tooltip img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
    display: block;
  }
  .bloom-testi__product-hover-wrap:hover .bloom-testi__product-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* Navigation & Progress Pill */
  .bloom-testi__nav {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background-color: var(--bloom-testi-nav-bg);
    padding: 6px 12px;
    border-radius: 9999px;
    box-shadow: 0 4px 18px rgba(41, 75, 61, 0.06);
    border: 1px solid rgba(41, 75, 61, 0.08);
    width: fit-content;
  }

  .bloom-testi__btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: var(--bloom-testi-nav-icon);
    cursor: pointer;
    padding: 0;
    margin: 0;
    overflow: hidden;
    transition: transform 0.2s ease;
  }
  .bloom-testi__btn:hover {
    transform: scale(1.08);
  }
  .bloom-testi__btn:active {
    transform: scale(0.95);
  }
  .bloom-testi__btn svg {
    width: 12px;
    height: 12px;
    fill: currentColor;
    z-index: 1;
  }

  .bloom-testi__btn-ripple {
    position: absolute;
    width: 0;
    height: 0;
    border-radius: 50%;
    background-color: rgba(41, 75, 61, 0.1);
    transform: translate(-50%, -50%);
    transition: width 0.35s ease-out, height 0.35s ease-out;
    pointer-events: none;
    z-index: 0;
  }
  .bloom-testi__btn:hover .bloom-testi__btn-ripple {
    width: 250%;
    height: 250%;
  }

  /* Progress Track */
  .bloom-testi__progress {
    width: 48px;
    height: 4px;
    background-color: var(--bloom-testi-progress-track);
    border-radius: 9999px;
    overflow: hidden;
    position: relative;
  }
  .bloom-testi__progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background-color: var(--bloom-testi-progress-bar);
    border-radius: 9999px;
    transition: width var(--bloom-testi-anim-dur) cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* -------------------------------------------------------------
     Responsive Breakpoints
     ------------------------------------------------------------- */
  @media screen and (max-width: 1024px) {
    .bloom-testi__card {
      padding-left: clamp(20px, 4vw, 40px);
      padding-right: clamp(20px, 4vw, 40px);
    }
    .bloom-testi__images-col {
      flex: 0 0 clamp(280px, 34vw, 360px);
      max-width: clamp(280px, 34vw, 360px);
    }
    .bloom-testi__quote-text {
      font-size: clamp(22px, 2.6vw, 26px);
    }
  }

  @media screen and (max-width: 768px) {
    .bloom-testi__card {
      padding-top: var(--bloom-testi-pt-mb);
      padding-bottom: var(--bloom-testi-pb-mb);
      padding-left: 18px;
      padding-right: 18px;
    }

    .bloom-testi__grid {
      flex-direction: column;
      align-items: center;
      text-align: left;
      gap: 36px;
    }

    .bloom-testi__images-col {
      flex: 0 0 min(100%, 300px);
      max-width: min(100%, 300px);
      margin: 0 auto;
    }

    .bloom-testi__content-col {
      width: 100%;
      align-items: flex-start;
    }

    .bloom-testi__quote-mark {
      margin-bottom: 16px;
    }
    .bloom-testi__quote-mark svg {
      width: 36px;
      height: 26px;
    }

    .bloom-testi__quote-text {
      font-size: var(--bloom-testi-font-sz-mb);
      line-height: 1.4;
      margin-bottom: 20px;
    }

    .bloom-testi__slides {
      min-height: 200px;
    }

    .bloom-testi__purchased {
      margin-bottom: 24px;
    }
  }

  @container (max-width: 768px) {
    .bloom-testi__grid {
      flex-direction: column !important;
      align-items: center !important;
      gap: 36px !important;
    }
    .bloom-testi__images-col {
      flex: 0 0 min(100%, 300px) !important;
      max-width: min(100%, 300px) !important;
      margin: 0 auto !important;
    }
    .bloom-testi__quote-text {
      font-size: var(--bloom-testi-font-sz-mb) !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bloom-testi__photo-card,
    .bloom-testi__photo-inner,
    .bloom-testi__slide,
    .bloom-testi__progress-bar {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<section
  id="bloom-testimonials-{{ section.id }}"
  class="bloom-testi-section-{{ section.id }} bloom-testi--{{ section_width }}{% if section_st.background_full_bleed %} bloom-testi--bleed-bg{% endif %}"
  aria-label="Customer Testimonials"
>
  <div class="bloom-testi__outer">
    <div class="bloom-testi__card">
      <div class="bloom-testi__content-wrap">
        <div class="bloom-testi__grid">

          <!-- Left Column: Layered Customer Photo Stack -->
          <div class="bloom-testi__images-col">
            <div class="bloom-testi__stack" id="BloomTestiStack-{{ section.id }}">
              {%- for block in section.blocks -%}
                {%- liquid
                  assign default_rotations = "5,0,-5,4,-4,3,-3" | split: ","
                  assign rot_idx = forloop.index0 | modulo: 7
                  assign rot_val = block.settings.rotation
                  if rot_val == 0 and block.settings.custom_rotation_override == false
                    assign rot_val = default_rotations[rot_idx]
                  endif

                  assign z_val = total_blocks | minus: forloop.index0
                -%}
                <div
                  class="bloom-testi__photo-card{% if forloop.first %} is-top{% endif %}"
                  data-index="{{ forloop.index0 }}"
                  data-rotate="{{ rot_val }}"
                  style="--card-rotate: {{ rot_val }}deg; z-index: {{ z_val }};"
                  {{ block.shopify_attributes }}
                >
                  <div class="bloom-testi__photo-inner">
                    {%- if block.settings.image != blank -%}
                      <img
                        src="{{ block.settings.image | image_url: width: 800 }}"
                        alt="{{ block.settings.image.alt | default: block.settings.author_name | escape }}"
                        class="bloom-testi__img"
                        loading="lazy"
                        width="800"
                        height="1000"
                      >
                    {%- else -%}
                      {%- liquid
                        assign sample_img = 'bloom-testimonial-' | append: forloop.index | append: '.jpg'
                      -%}
                      <img
                        src="{{ sample_img | asset_url }}"
                        alt="{{ block.settings.author_name | escape }}"
                        class="bloom-testi__img"
                        loading="lazy"
                        width="800"
                        height="1000"
                      >
                    {%- endif -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          </div>

          <!-- Right Column: Testimonial Content & Slider -->
          <div class="bloom-testi__content-col">

            <!-- Decorative Quotation Mark -->
            {%- if section_st.show_quote_mark -%}
              <div class="bloom-testi__quote-mark" aria-hidden="true">
                <svg width="41" height="30" viewBox="0 0 41 30" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M7.93555 13.877H2.46871V0H19.2188V9.50329C19.2188 19.1506 12.4876 27.5084 3.05142 29.5164C2.20631 29.6963 1.69842 29.7486 1.69842 29.7486L0 25.6106C7.50351 21.8694 7.93555 13.877 7.93555 13.877ZM29.7147 13.877H24.2479V0H41V9.50329C41 19.1506 34.2683 27.5084 24.8322 29.5164C23.9871 29.6963 23.4797 29.7486 23.4797 29.7486L21.7812 25.6106C29.2822 21.8694 29.7147 13.877 29.7147 13.877Z" fill="currentColor"/>
                </svg>
              </div>
            {%- endif -%}

            <!-- Slides Container -->
            <div class="bloom-testi__slides" id="BloomTestiSlides-{{ section.id }}">
              {%- for block in section.blocks -%}
                {%- liquid
                  assign product_item = block.settings.product
                  assign product_title = block.settings.custom_product_title
                  assign product_url = block.settings.custom_product_url
                  assign product_img = block.settings.custom_product_image

                  if product_item != blank
                    assign product_title = product_item.title
                    assign product_url = product_item.url
                    if product_item.featured_image != blank
                      assign product_img = product_item.featured_image
                    endif
                  endif
                -%}
                <div
                  class="bloom-testi__slide{% if forloop.first %} is-active{% endif %}"
                  data-index="{{ forloop.index0 }}"
                  id="BloomSlide-{{ section.id }}-{{ forloop.index0 }}"
                  {{ block.shopify_attributes }}
                >
                  <!-- Star Rating -->
                  {%- if section_st.show_star_rating -%}
                    <div class="bloom-testi__stars" aria-label="{{ block.settings.rating | default: 5 }} out of 5 stars">
                      {%- assign star_rate = block.settings.rating | default: 5 -%}
                      {%- for i in (1..5) -%}
                        <svg class="bloom-testi__star{% if i > star_rate %} is-empty{% endif %}" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M10 1L12.7 6.6L19 7.4L14.4 11.7L15.6 18L10 14.9L4.4 18L5.6 11.7L1 7.4L7.3 6.6L10 1Z" fill="currentColor"/>
                        </svg>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}

                  <!-- Review Text -->
                  <div class="bloom-testi__quote-text">
                    <p>{{ block.settings.quote | escape }}</p>
                  </div>

                  <!-- Author & Verified Customer Badge -->
                  <div class="bloom-testi__author-wrap">
                    {%- if block.settings.show_verified -%}
                      <span class="bloom-testi__verified-icon" aria-hidden="true" title="Verified Customer">
                        <svg width="14" height="15" viewBox="0 0 14 15" fill="none" xmlns="http://www.w3.org/2000/svg">
