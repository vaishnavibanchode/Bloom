<script>
  (function() {
    function initTestimonialsSection() {
      const sectionEl = document.getElementById('bloom-testimonials-{{ section.id }}');
      if (!sectionEl || sectionEl.dataset.initialized === 'true') return;
      sectionEl.dataset.initialized = 'true';

      const stackEl = document.getElementById('BloomTestiStack-{{ section.id }}');
      const slidesContainer = document.getElementById('BloomTestiSlides-{{ section.id }}');
      const navEl = document.getElementById('BloomTestiNav-{{ section.id }}');
      if (!stackEl || !slidesContainer) return;

      const cards = Array.from(stackEl.querySelectorAll('.bloom-testi__photo-card'));
      const slides = Array.from(slidesContainer.querySelectorAll('.bloom-testi__slide'));
      const total = cards.length;
      if (total <= 1) return;

      const progressBar = navEl ? navEl.querySelector('.bloom-testi__progress-bar') : null;
      const prevBtn = navEl ? navEl.querySelector('.bloom-testi__btn--prev') : null;
      const nextBtn = navEl ? navEl.querySelector('.bloom-testi__btn--next') : null;

      let currentIndex = 0;
      let isAnimating = false;
      const animDuration = parseInt('{{ section_st.animation_duration | default: 400 }}', 10) || 400;
      const isCardAnimEnabled = {{ section_st.enable_card_animation | default: true }};
      const isAutoplay = {{ section_st.enable_autoplay | default: false }};
      const autoplayInterval = (parseInt('{{ section_st.autoplay_interval | default: 6 }}', 10) || 6) * 1000;
      let autoplayTimer = null;

      // Track z-indexes
      let zMap = cards.map((_, i) => total - i);

      function updateZIndexes() {
        cards.forEach((card, i) => {
          card.style.zIndex = zMap[i];
          if (zMap[i] === total) {
            card.classList.add('is-top');
          } else {
            card.classList.remove('is-top');
          }
        });
      }
      updateZIndexes();

      function goToSlide(targetIndex, direction = 'next') {
        if (targetIndex === currentIndex || isAnimating) return;
        isAnimating = true;

        const oldIndex = currentIndex;
        currentIndex = targetIndex;

        // 1. Animate Text Slides
        slides[oldIndex].classList.remove('is-active');
        slides[currentIndex].classList.add('is-active');

        // 2. Animate Progress Bar
        if (progressBar) {
          const pct = ((currentIndex + 1) / total) * 100;
          progressBar.style.width = pct + '%';
          progressBar.setAttribute('aria-valuenow', currentIndex + 1);
        }

        // 3. Layered Card Shuffle Animation
        if (isCardAnimEnabled && window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
          const outgoingCard = cards[oldIndex];
          const incomingCard = cards[currentIndex];
          const cardWidth = outgoingCard.offsetWidth || 340;
          const slideOffset = direction === 'next' ? (cardWidth + 40) : -(cardWidth + 40);

          // Slide top card out
          outgoingCard.style.transform = `translateX(${slideOffset}px) scale(0.96)`;
          outgoingCard.style.opacity = '0.9';

          setTimeout(() => {
            // Re-order z-index: outgoing card goes to back (1), incoming card goes to top (total)
            if (direction === 'next') {
              zMap = zMap.map(z => (z < total ? z + 1 : 1));
            } else {
              zMap = zMap.map(z => (z > 1 ? z - 1 : total));
            }
            updateZIndexes();

            // Slide card back in at bottom of stack
            outgoingCard.style.transform = 'translateX(0) scale(1)';
            outgoingCard.style.opacity = '1';

            setTimeout(() => {
              isAnimating = false;
            }, animDuration * 0.7);
          }, animDuration * 0.5);
        } else {
          // Instant change without slide
          zMap = zMap.map((_, i) => (i === currentIndex ? total : 1));
          updateZIndexes();
          isAnimating = false;
        }
      }

      function nextSlide() {
        const nextIdx = (currentIndex + 1) % total;
        goToSlide(nextIdx, 'next');
      }

      function prevSlide() {
        const prevIdx = (currentIndex - 1 + total) % total;
        goToSlide(prevIdx, 'prev');
      }

      if (nextBtn) nextBtn.addEventListener('click', nextSlide);
      if (prevBtn) prevBtn.addEventListener('click', prevSlide);

      // Keyboard navigation
      sectionEl.addEventListener('keydown', function(e) {
        if (e.key === 'ArrowRight') nextSlide();
        else if (e.key === 'ArrowLeft') prevSlide();
      });

      // Autoplay setup
      function startAutoplay() {
        if (!isAutoplay || autoplayTimer) return;
        autoplayTimer = setInterval(nextSlide, autoplayInterval);
      }
      function stopAutoplay() {
        if (autoplayTimer) {
          clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      }

      if (isAutoplay) {
        startAutoplay();
        sectionEl.addEventListener('mouseenter', stopAutoplay);
        sectionEl.addEventListener('mouseleave', startAutoplay);
        sectionEl.addEventListener('focusin', stopAutoplay);
        sectionEl.addEventListener('focusout', startAutoplay);
      }

      // Shopify Theme Editor Event Handling
      if (window.Shopify && Shopify.designMode) {
        document.addEventListener('shopify:block:select', function(event) {
          if (event.detail.sectionId === '{{ section.id }}') {
            const blockIndex = cards.findIndex(c => c.getAttribute('data-index') == event.detail.blockId || cards.indexOf(c) == event.target.dataset.index);
            if (blockIndex !== -1) {
              goToSlide(blockIndex, 'next');
            }
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTestimonialsSection);
    } else {
      initTestimonialsSection();
    }

    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') {
        initTestimonialsSection();
      }
    });
  })();
</script>

