                    class="bloom-testi__progress-bar"
                    style="width: {{ initial_pct }}%;"
                    role="progressbar"
                    aria-valuenow="1"
                    aria-valuemin="1"
                    aria-valuemax="{{ total_blocks }}"
                  ></div>
                </div>

                <button
                  type="button"
                  class="bloom-testi__btn bloom-testi__btn--next"
                  aria-label="Next testimonial"
                >
                  <svg width="8" height="7" viewBox="0 0 8 7" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M7.834 4.271C7.94 4.162 8 4.016 8 3.863C8 3.71 7.94 3.563 7.834 3.454L5.559 1.146C5.452 1.037 5.308 0.977 5.157 0.977C5.006 0.977 4.861 1.037 4.755 1.146C4.535 1.369 4.535 1.731 4.755 1.962L6.059 3.285L0.569 3.285C0.255 3.285 0 3.544 0 3.863C0 4.182 0.255 4.44 0.569 4.44L6.059 4.44L4.755 5.763C4.535 5.986 4.535 6.348 4.755 6.579C4.975 6.807 5.339 6.807 5.559 6.579L7.834 4.271Z" fill="currentColor"/>
                  </svg>
                  <span class="bloom-testi__btn-ripple" aria-hidden="true"></span>
                </button>
