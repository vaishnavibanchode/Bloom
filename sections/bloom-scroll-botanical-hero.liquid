{{ 'bloom-scroll-botanical-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bloom-scroll-botanical-hero.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign section_st = section.settings
  assign btn_url = section_st.p2_button_link
  if btn_url == blank
    assign btn_url = routes.all_products_collection_url
  endif
-%}

{%- if section_st.enable_section -%}
  <bloom-scroll-hero
    id="bloom-scroll-hero-{{ section.id }}"
    class="bloom-scroll-hero"
    data-animation="{{ section_st.enable_animation }}"
    style="
      --bsh-track-h: {{ section_st.scroll_track_height }}vh;
      --bsh-p1-grad-top: {{ section_st.p1_gradient_top }};
      --bsh-p1-grad-bottom: {{ section_st.p1_gradient_bottom }};
      --bsh-p1-text-color: {{ section_st.p1_text_color }};
      --bsh-p2-bg: {{ section_st.p2_background_color }};
      --bsh-p2-text-color: {{ section_st.p2_text_color }};
      --bsh-p2-heading-sz: {{ section_st.p2_heading_size }}px;
      --bsh-p2-heading-sz-mb: {{ section_st.p2_heading_size_mobile }}px;
    "
  >
    <!-- Scroll Track (defines the scrolling distance) -->
    <div class="bloom-scroll-hero__track">
      <!-- Sticky Viewport Window -->
      <div class="bloom-scroll-hero__viewport">

        <!-- ======================================================================
             PHASE 1: Mint/Sage Gradient with Floating Botanical Items & Spring Savings
             ====================================================================== -->
        <div class="bloom-scroll-hero__phase-one" aria-hidden="false">
          <div class="bloom-scroll-hero__phase-one-bg"></div>

          <!-- Floating Botanical Elements -->
          <div class="bloom-scroll-hero__floating-layer">
            <!-- 1. Centered Peach Flower -->
            <div class="bloom-scroll-hero__item bloom-scroll-hero__item--flower" data-item="flower">
              {%- if section_st.float_img_flower != blank -%}
                <img
                  src="{{ section_st.float_img_flower | image_url: width: 600 }}"
                  alt="Flower"
                  width="250"
                  height="250"
                  loading="eager"
                >
              {%- else -%}
                <img
                  src="{{ 'bloom-scroll-flower.png' | asset_url }}"
                  alt="Peach flower"
                  width="250"
                  height="250"
                  loading="eager"
                >
              {%- endif -%}
            </div>

            <!-- 2. Tropical Monstera Leaf (Bottom Center) -->
            <div class="bloom-scroll-hero__item bloom-scroll-hero__item--monstera" data-item="monstera">
              {%- if section_st.float_img_monstera != blank -%}
                <img
                  src="{{ section_st.float_img_monstera | image_url: width: 600 }}"
                  alt="Monstera leaf"
                  width="240"
                  height="240"
                  loading="eager"
                >
              {%- else -%}
                <img
                  src="{{ 'bloom-scroll-monstera.png' | asset_url }}"
                  alt="Monstera leaf"
                  width="240"
                  height="240"
                  loading="eager"
                >
              {%- endif -%}
            </div>

            <!-- 3. Person Holding Plant (Bottom Left) -->
            <div class="bloom-scroll-hero__item bloom-scroll-hero__item--person" data-item="person">
              {%- if section_st.float_img_person != blank -%}
                <img
                  src="{{ section_st.float_img_person | image_url: width: 600 }}"
                  alt="Plant lover"
                  width="250"
                  height="250"
                  loading="eager"
                >
              {%- else -%}
                <img
                  src="{{ 'bloom-scroll-person.png' | asset_url }}"
                  alt="Person holding plant"
                  width="250"
                  height="250"
                  loading="eager"
                >
              {%- endif -%}
            </div>

            <!-- 4. Garden Trowel (Bottom Right) -->
            <div class="bloom-scroll-hero__item bloom-scroll-hero__item--trowel" data-item="trowel">
              {%- if section_st.float_img_trowel != blank -%}
                <img
                  src="{{ section_st.float_img_trowel | image_url: width: 500 }}"
                  alt="Garden trowel"
                  width="210"
                  height="210"
                  loading="eager"
                >
              {%- else -%}
                <img
                  src="{{ 'bloom-scroll-trowel.png' | asset_url }}"
                  alt="Garden trowel"
                  width="210"
                  height="210"
                  loading="eager"
                >
              {%- endif -%}
            </div>

            <!-- 5. Watering Can (Top Right) -->
            <div class="bloom-scroll-hero__item bloom-scroll-hero__item--can" data-item="can">
              {%- if section_st.float_img_can != blank -%}
                <img
                  src="{{ section_st.float_img_can | image_url: width: 550 }}"
                  alt="Watering can"
                  width="220"
                  height="220"
                  loading="eager"
                >
              {%- else -%}
                <img
                  src="{{ 'bloom-scroll-can.png' | asset_url }}"
                  alt="Orange watering can"
                  width="220"
                  height="220"
                  loading="eager"
                >
              {%- endif -%}
            </div>

            <!-- 6. Potted Snake Plant (Top Left) -->
            <div class="bloom-scroll-hero__item bloom-scroll-hero__item--pot" data-item="pot">
              {%- if section_st.float_img_pot != blank -%}
                <img
                  src="{{ section_st.float_img_pot | image_url: width: 550 }}"
                  alt="Potted plant"
                  width="210"
                  height="210"
                  loading="eager"
                >
              {%- else -%}
                <img
                  src="{{ 'bloom-scroll-pot.png' | asset_url }}"
                  alt="Potted snake plant"
                  width="210"
                  height="210"
                  loading="eager"
                >
              {%- endif -%}
            </div>
          </div>

          <!-- Spring Savings Centered Text -->
          <div class="bloom-scroll-hero__spring-content">
            {%- if section_st.p1_subheading != blank -%}
              <span class="bloom-scroll-hero__spring-subheading">{{ section_st.p1_subheading }}</span>
            {%- endif -%}
            {%- if section_st.p1_heading != blank -%}
              <h2 class="bloom-scroll-hero__spring-heading">
                {{ section_st.p1_heading }}
                {%- if section_st.p1_heading_italic != blank -%}
                  <em>{{ section_st.p1_heading_italic }}</em>
                {%- endif -%}
              </h2>
            {%- endif -%}
          </div>
        </div>

        <!-- ======================================================================
             PHASE 2: Expanding Botanical Hero Card ("Grow Your Green Space")
             ====================================================================== -->
        <div class="bloom-scroll-hero__phase-two" aria-hidden="false">
          <div class="bloom-scroll-hero__card">
            <!-- Panoramic Botanical 5-People Image -->
            <div class="bloom-scroll-hero__card-media">
              <picture>
                {%- if section_st.p2_mobile_image != blank -%}
                  <source
                    media="(max-width: 767px)"
                    srcset="{{ section_st.p2_mobile_image | image_url: width: 1200 }}"
                  >
                {%- endif -%}
                {%- if section_st.p2_desktop_image != blank -%}
                  <img
                    src="{{ section_st.p2_desktop_image | image_url: width: 2400 }}"
                    alt="{{ section_st.p2_heading_regular | escape }} {{ section_st.p2_heading_italic | escape }}"
                    class="bloom-scroll-hero__panoramic-img"
                    width="2400"
                    height="1350"
                    loading="eager"
                  >
                {%- else -%}
                  <img
                    src="{{ 'bloom-scroll-hero-panoramic.jpg' | asset_url }}"
                    alt="Botanical lovers holding plants"
                    class="bloom-scroll-hero__panoramic-img"
                    width="2400"
                    height="1350"
                    loading="eager"
                  >
                {%- endif -%}
              </picture>
              <!-- Subtle vignette overlay for enhanced text readability -->
              <div class="bloom-scroll-hero__card-overlay"></div>
            </div>

            <!-- Centered Editorial Botanical Content -->
            <div class="bloom-scroll-hero__card-content">
              <div class="bloom-scroll-hero__card-text-inner">
                <h2 class="bloom-scroll-hero__card-heading">
                  {{ section_st.p2_heading_regular }}
                  {%- if section_st.p2_heading_italic != blank -%}
                    <em>{{ section_st.p2_heading_italic }}</em>
                  {%- endif -%}
                </h2>

                {%- if section_st.p2_description != blank -%}
                  <div class="bloom-scroll-hero__card-description">
                    <p>{{ section_st.p2_description }}</p>
                  </div>
                {%- endif -%}

                {%- if section_st.p2_button_label != blank -%}
                  <div class="bloom-scroll-hero__card-btn-container">
                    <a href="{{ btn_url }}" class="bloom-scroll-hero__pill-btn">
                      <span class="bloom-scroll-hero__btn-text">{{ section_st.p2_button_label }}</span>
                      <svg class="bloom-scroll-hero__btn-arrow" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                      </svg>
                    </a>
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </bloom-scroll-hero>
{%- endif -%}

{% schema %}
{
  "name": "Botanical Scroll Hero",
  "tag": "section",
  "class": "bloom-scroll-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Visibility & Scroll"
    },
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable Section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "Enable Scroll-Linked Animation",
      "info": "Ties transforms, reveal clip, and parallax directly to user scroll progress.",
      "default": true
    },
    {
      "type": "range",
      "id": "scroll_track_height",
      "label": "Scroll Track Height (vh)",
      "min": 200,
      "max": 500,
      "step": 20,
      "default": 340,
      "info": "Total scroll distance required to scrub from Phase 1 through full Phase 2 expansion."
    },
    {
      "type": "header",
      "content": "Phase 1: Spring Savings"
    },
    {
      "type": "color",
      "id": "p1_gradient_top",
      "label": "Phase 1 Gradient Top Color",
      "default": "#FAF9EF"
    },
    {
      "type": "color",
      "id": "p1_gradient_bottom",
      "label": "Phase 1 Gradient Bottom Color",
      "default": "#C4D8BD"
    },
    {
      "type": "color",
      "id": "p1_text_color",
      "label": "Phase 1 Text Color",
      "default": "#2D4A3E"
    },
    {
      "type": "text",
      "id": "p1_subheading",
      "label": "Subheading",
      "default": "SALE UP TO 30% OFF"
    },
    {
      "type": "text",
      "id": "p1_heading",
      "label": "Heading",
      "default": "Spring"
    },
    {
      "type": "text",
      "id": "p1_heading_italic",
      "label": "Heading Italic Word",
      "default": "Savings"
    },
    {
      "type": "header",
      "content": "Phase 1: Floating Botanical Items"
    },
    {
      "type": "image_picker",
      "id": "float_img_flower",
      "label": "Item 1: Center Flower (Top)"
    },
    {
      "type": "image_picker",
      "id": "float_img_monstera",
      "label": "Item 2: Tropical Leaf (Bottom Center)"
    },
    {
      "type": "image_picker",
      "id": "float_img_person",
      "label": "Item 3: Person with Plant (Bottom Left)"
    },
    {
      "type": "image_picker",
      "id": "float_img_trowel",
      "label": "Item 4: Garden Trowel (Bottom Right)"
    },
    {
      "type": "image_picker",
      "id": "float_img_can",
      "label": "Item 5: Watering Can (Top Right)"
    },
    {
      "type": "image_picker",
      "id": "float_img_pot",
      "label": "Item 6: Potted Plant (Top Left)"
    },
    {
      "type": "header",
      "content": "Phase 2: Botanical Hero Card"
    },
    {
      "type": "image_picker",
      "id": "p2_desktop_image",
      "label": "Botanical Panoramic Hero Image (Desktop)",
      "info": "High-resolution wide image featuring 5 people holding plants along the bottom on a muted grey backdrop."
    },
    {
      "type": "image_picker",
      "id": "p2_mobile_image",
      "label": "Botanical Panoramic Hero Image (Mobile)"
    },
    {
      "type": "color",
      "id": "p2_background_color",
      "label": "Card Background Color",
      "default": "#9C9D97"
    },
    {
      "type": "color",
      "id": "p2_text_color",
      "label": "Card Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "p2_heading_regular",
      "label": "Heading Regular Text",
      "default": "Grow Your"
    },
    {
      "type": "text",
      "id": "p2_heading_italic",
      "label": "Heading Italic Text",
      "default": "Green Space"
    },
    {
      "type": "range",
      "id": "p2_heading_size",
      "label": "Heading Font Size (Desktop)",
      "min": 40,
      "max": 90,
      "step": 2,
      "unit": "px",
      "default": 68
    },
    {
      "type": "range",
      "id": "p2_heading_size_mobile",
      "label": "Heading Font Size (Mobile)",
      "min": 28,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "textarea",
      "id": "p2_description",
      "label": "Supporting Description",
      "default": "Discover beautiful plants and thoughtfully designed pots to refresh your home. Create a calming atmosphere and bring nature closer to everyday living."
    },
    {
      "type": "text",
      "id": "p2_button_label",
      "label": "Button Label",
      "default": "SHOP COLLECTION"
    },
    {
      "type": "url",
      "id": "p2_button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Botanical Scroll Hero",
      "settings": {
        "p1_subheading": "SALE UP TO 30% OFF",
        "p1_heading": "Spring",
        "p1_heading_italic": "Savings",
        "p2_heading_regular": "Grow Your",
        "p2_heading_italic": "Green Space",
        "p2_description": "Discover beautiful plants and thoughtfully designed pots to refresh your home. Create a calming atmosphere and bring nature closer to everyday living.",
        "p2_button_label": "SHOP COLLECTION"
      }
    }
  ]
}
{% endschema %}